[36m(WorkerDict pid=218554)[0m afterremove def solve():
[36m(WorkerDict pid=218554)[0m     s, k = input(), int(input())
[36m(WorkerDict pid=218554)[0m     n = len(s)
[36m(WorkerDict pid=218554)[0m     # dp[i][j] := min operations to make s[:i] equal to s[:j]
[36m(WorkerDict pid=218554)[0m     dp = [[float('inf')] * (k + 1) for _ in range(n + 1)] 
[36m(WorkerDict pid=218554)[0m   
[36m(WorkerDict pid=218554)[0m     # Initialize the base cases 
[36m(WorkerDict pid=218554)[0m     dp[0][0] = 0
[36m(WorkerDict pid=218554)[0m     for i in range(1, n + 1):
[36m(WorkerDict pid=218554)[0m         for j in range(1, k + 1): 
[36m(WorkerDict pid=218554)[0m             # If we can make the substring equal 
[36m(WorkerDict pid=218554)[0m             for c in range(26): 
[36m(WorkerDict pid=218554)[0m                 # Check if the character is different 
[36m(WorkerDict pid=218554)[0m                 if chr(ord('a') + c) != s[i - 1]: 
[36m(WorkerDict pid=218554)[0m                     # Update the minimum operations 
[36m(WorkerDict pid=218554)[0m                     dp[i][j] = min(dp[i][j], dp[i - 1][j - 1] + 1) 
[36m(WorkerDict pid=218554)[0m   
[36m(WorkerDict pid=218554)[0m     # Return the minimum operations for the entire string 
[36m(WorkerDict pid=218554)[0m             dp[i][j] = min(dp[i][j], dp[i - 1][j]) 
[36m(WorkerDict pid=218554)[0m   
[36m(WorkerDict pid=218554)[0m     # Return the minimum operations for the entire string 
[36m(WorkerDict pid=218554)[0m     print(dp[-1][-1]) 
