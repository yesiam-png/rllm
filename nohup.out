[36m(WorkerDict pid=218554)[0m   
[36m(WorkerDict pid=218554)[0m     # Initialize the number of moves to 0 
[36m(WorkerDict pid=218554)[0m     if n == 1:
[36m(WorkerDict pid=218554)[0m         return 2 
[36m(WorkerDict pid=218554)[0m   
[36m(WorkerDict pid=218554)[0m     # Initialize the number of moves to 0 
[36m(WorkerDict pid=218554)[0m     dp = [0] * (n + 1) 
[36m(WorkerDict pid=218554)[0m   
