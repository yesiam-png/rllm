[36m(WorkerDict pid=914214)[0m         return N 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m     # Calculate the shortest time needed 
[36m(WorkerDict pid=914214)[0m     else:
[36m(WorkerDict pid=914214)[0m         return (N - 1) // A + (N - 1) % A + 1
