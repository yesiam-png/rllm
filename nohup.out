[36m(WorkerDict pid=914464)[0m def solve():
[36m(WorkerDict pid=914464)[0m     # Check if the input string is empty
[36m(WorkerDict pid=914464)[0m     def sum_digits(s): 
[36m(WorkerDict pid=914464)[0m         # Return the sum of digits in the string 
[36m(WorkerDict pid=914464)[0m         return sum(int(c) for c in s) 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m     # Check if the input string is a valid ticket 
[36m(WorkerDict pid=914464)[0m 
[36m(WorkerDict pid=914464)[0m     def luck_check(ticket): 
[36m(WorkerDict pid=914464)[0m         # Check if the ticket is a valid string 
[36m(WorkerDict pid=914464)[0m         if len(ticket) <= 1:
[36m(WorkerDict pid=914464)[0m             return True 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m         # Check if the sum of digits on both halves is equal 
[36m(WorkerDict pid=914464)[0m         else:
[36m(WorkerDict pid=914464)[0m             return sum_digits(ticket[:len(ticket)//2]) == sum_digits(ticket[len(ticket)//2:]) 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m     # Return the result of the ticket check 
[36m(WorkerDict pid=914464)[0m 
[36m(WorkerDict pid=914464)[0m     # Test cases
[36m(WorkerDict pid=914464)[0m     print(luck_check('003111'))  # True
[36m(WorkerDict pid=914464)[0m     print(luck_check('813372'))  # True
[36m(WorkerDict pid=914464)[0m     print(luck_check('17935'))  # True
