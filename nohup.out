[36m(WorkerDict pid=914465)[0m def solve():
[36m(WorkerDict pid=914465)[0m     n = int(input()) 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Create a list to store the edges 
[36m(WorkerDict pid=914465)[0m     edges = [] 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Iterate through each edge 
[36m(WorkerDict pid=914465)[0m     for _ in range(n-1): 
[36m(WorkerDict pid=914465)[0m         # Read the edge details 
[36m(WorkerDict pid=914465)[0m         edges.append(list(map(int, input().split()))) 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Initialize the diameter to 0 
[36m(WorkerDict pid=914465)[0m     graph = [set() for i in range(n)] 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Iterate through each edge 
[36m(WorkerDict pid=914465)[0m     for i in range(n-1): 
[36m(WorkerDict pid=914465)[0m         # Add the edges to the graph 
[36m(WorkerDict pid=914465)[0m         graph[edges[i][0]].add(edges[i][1])
[36m(WorkerDict pid=914465)[0m         graph[edges[i][1]].add(edges[i][0]) 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Initialize the diameter to 0 
[36m(WorkerDict pid=914465)[0m     def dfs(i, parent): 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m         # Initialize the maximum distance to 0 
[36m(WorkerDict pid=914465)[0m         max1, max2 = 0, 0 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m         # Iterate through each neighbor 
[36m(WorkerDict pid=914465)[0m         for j in graph[i]: 
[36m(WorkerDict pid=914465)[0m             # If the neighbor is not the parent 
[36m(WorkerDict pid=914465)[0m             if j != parent: 
[36m(WorkerDict pid=914465)[0m                 # Recur for the neighbor 
[36m(WorkerDict pid=914465)[0m                 d = dfs(j, i) 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m                 # Update the maximum distances 
[36m(WorkerDict pid=914465)[0m                 if d > max1:
