[36m(WorkerDict pid=1436351)[0m class Solution:
[36m(WorkerDict pid=1436351)[0m     def minimumBoxes(self, apple: List[int], capacity: List[int]) -> int:
[36m(WorkerDict pid=1436351)[0m         # Sort the apple and capacity lists
[36m(WorkerDict pid=1436351)[0m         total = sum(apple)  # Calculate the total number of apples
[36m(WorkerDict pid=1436351)[0m         capacity.sort()     # Sort the capacity list in ascending order
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Initialize the number of boxes needed
[36m(WorkerDict pid=1436351)[0m         capacity.append(0)  # Add a dummy value to the end of the capacity list
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Initialize the number of boxes needed
[36m(WorkerDict pid=1436351)[0m 
[36m(WorkerDict pid=1436351)[0m         # Initialize the count of boxes needed
[36m(WorkerDict pid=1436351)[0m         count = 0
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Iterate through each box capacity
[36m(WorkerDict pid=1436351)[0m 
[36m(WorkerDict pid=1436351)[0m         # Iterate through the capacity list
[36m(WorkerDict pid=1436351)[0m         for i in range(len(capacity) - 1, -1, -1): 
[36m(WorkerDict pid=1436351)[0m             # Add the apples to the current box
[36m(WorkerDict pid=1436351)[0m             # Calculate the number of boxes needed to hold the remaining apples
[36m(WorkerDict pid=1436351)[0m             count += (total - apple[:i].sum()) // capacity[i] 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m             # Update the remaining apples
[36m(WorkerDict pid=1436351)[0m             # Update the total number of apples
[36m(WorkerDict pid=1436351)[0m             total -= (total - apple[:i].sum()) % capacity[i] 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m         # Return the total number of boxes needed
[36m(WorkerDict pid=1436351)[0m 
[36m(WorkerDict pid=1436351)[0m         return count
