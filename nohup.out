[36m(WorkerDict pid=218553)[0m     i = 1
[36m(WorkerDict pid=218553)[0m     while n > 0: 
[36m(WorkerDict pid=218553)[0m         # Check if the position is reached 
[36m(WorkerDict pid=218553)[0m         if n <= l * i: 
[36m(WorkerDict pid=218553)[0m             # Update the result and break the loop 
[36m(WorkerDict pid=218553)[0m             res += l
[36m(WorkerDict pid=218553)[0m             n -= l * i
[36m(WorkerDict pid=218553)[0m             if n <= 0:
