[36m(WorkerDict pid=914459)[0m     x, y, z = map(int, input().split())
[36m(WorkerDict pid=914459)[0m     if x == y and x != y + z:
[36m(WorkerDict pid=914459)[0m         return n
[36m(WorkerDict pid=914459)[0m     res = 0
[36m(WorkerDict pid=914459)[0m     for i in range(m):
[36m(WorkerDict pid=914459)[0m         x, y, z = map(int, input().split())
[36m(WorkerDict pid=914459)[0m         if x == y and x != y + z:
