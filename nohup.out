[36m(WorkerDict pid=218555)[0m     n, m = map(int, input().split())
[36m(WorkerDict pid=218555)[0m     seat = list(map(int, input().split())) 
[36m(WorkerDict pid=218555)[0m     # Initialize the number of operations to 0 
[36m(WorkerDict pid=218555)[0m     count = 0 
[36m(WorkerDict pid=218555)[0m   
[36m(WorkerDict pid=218555)[0m     # Iterate until the conditions are met 
[36m(WorkerDict pid=218555)[0m     for i in range(m): 
[36m(WorkerDict pid=218555)[0m         # Check if the seat is empty 
[36m(WorkerDict pid=218555)[0m         if seat[i] != i+1: 
[36m(WorkerDict pid=218555)[0m             # Move the student to the front 
[36m(WorkerDict pid=218555)[0m             count += 1 
[36m(WorkerDict pid=218555)[0m   
[36m(WorkerDict pid=218555)[0m             # Update the seat of the student 
[36m(WorkerDict pid=218555)[0m             seat[i], seat[seat[i]-1] = seat[seat[i]-1], seat[i] 
[36m(WorkerDict pid=218555)[0m   
[36m(WorkerDict pid=218555)[0m     # Return the number of operations 
[36m(WorkerDict pid=218555)[0m     return count 
