[36m(WorkerDict pid=218551)[0m afterremove def solve():
[36m(WorkerDict pid=218551)[0m     p, d = map(int, input().split()) 
[36m(WorkerDict pid=218551)[0m     # Calculate the maximum number of nines 
[36m(WorkerDict pid=218551)[0m     while d: 
[36m(WorkerDict pid=218551)[0m         # Update the remaining price and discount 
[36m(WorkerDict pid=218551)[0m         p //= 10
[36m(WorkerDict pid=218551)[0m         d -= 1 
