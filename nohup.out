[36m(WorkerDict pid=914214)[0m     while n > 0: 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m         # Check if the cookies can be eaten 
[36m(WorkerDict pid=914214)[0m         if a < n: 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m             # Eat all the cookies 
[36m(WorkerDict pid=914214)[0m             n %= a + 1 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m         # Otherwise, bake more cookies 
[36m(WorkerDict pid=914214)[0m         else: 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m             # Eat the cookies and move to the next second 
