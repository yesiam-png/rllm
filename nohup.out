[36m(WorkerDict pid=1436351)[0m class Solution:
[36m(WorkerDict pid=1436351)[0m     def minimumBoxes(self, apple: List[int], capacity: List[int]) -> int:
[36m(WorkerDict pid=1436351)[0m         # Sort the arrays in ascending order
[36m(WorkerDict pid=1436351)[0m         apple.sort()
[36m(WorkerDict pid=1436351)[0m         capacity.sort() 
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Initialize the total number of boxes needed
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Initialize the minimum number of boxes to 0
[36m(WorkerDict pid=1436351)[0m         min_boxes = 0 
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Iterate through the arrays until all apples are distributed
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Iterate over the apple array
[36m(WorkerDict pid=1436351)[0m         for i in range(len(capacity) - 1, -1, -1): 
[36m(WorkerDict pid=1436351)[0m             # Check if there are apples left to distribute
[36m(WorkerDict pid=1436351)[0m             # Calculate the total capacity of the remaining boxes
[36m(WorkerDict pid=1436351)[0m             total_capacity = sum(capacity[i:]) 
[36m(WorkerDict pid=1436351)[0m             
[36m(WorkerDict pid=1436351)[0m             # Check if all apples can be distributed
[36m(WorkerDict pid=1436351)[0m             # If the total capacity is greater than or equal to the current apple, we can distribute it
[36m(WorkerDict pid=1436351)[0m             if total_capacity >= apple[i]: 
[36m(WorkerDict pid=1436351)[0m                 # Increment the number of boxes needed
[36m(WorkerDict pid=1436351)[0m                 # Decrease the total capacity by the apple
[36m(WorkerDict pid=1436351)[0m                 total_capacity -= apple[i] 
[36m(WorkerDict pid=1436351)[0m                 # Increment the number of boxes needed
[36m(WorkerDict pid=1436351)[0m                 # Increment the minimum number of boxes
[36m(WorkerDict pid=1436351)[0m                 min_boxes += 1 
[36m(WorkerDict pid=1436351)[0m             
[36m(WorkerDict pid=1436351)[0m             # Break out of the loop if all apples are distributed
[36m(WorkerDict pid=1436351)[0m             # If the total capacity is less than the current apple, we can't distribute it, so we break out of the loop
[36m(WorkerDict pid=1436351)[0m             else:
[36m(WorkerDict pid=1436351)[0m                 break 
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Return the minimum number of boxes needed
[36m(WorkerDict pid=1436351)[0m         return min_boxes
