[36m(WorkerDict pid=914461)[0m     dp = [[0] * m for _ in range(n)]
[36m(WorkerDict pid=914461)[0m     for i in range(n):
[36m(WorkerDict pid=914461)[0m         for j in range(m):
[36m(WorkerDict pid=914461)[0m             if i == 0:
[36m(WorkerDict pid=914461)[0m                 dp[i][j] = matrix[i][j]
[36m(WorkerDict pid=914461)[0m             else:
[36m(WorkerDict pid=914461)[0m                 for l in range(min(j + 1, m - (j + 1) % 2)):
[36m(WorkerDict pid=914461)[0m                     dp[i][j] = max(dp[i][j], dp[i - 1][j - l] + matrix[i][j])
