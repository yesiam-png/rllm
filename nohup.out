[36m(WorkerDict pid=218555)[0m     n = int(input())
[36m(WorkerDict pid=218555)[0m     p = list(map(int, input().split()))
[36m(WorkerDict pid=218555)[0m     dp = [0] * (n + 1)
[36m(WorkerDict pid=218555)[0m     dp[1] = 2
[36m(WorkerDict pid=218555)[0m     for i in range(2, n + 1): 
