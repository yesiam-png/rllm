[36m(WorkerDict pid=218554)[0m 
[36m(WorkerDict pid=218554)[0m afterremove def solve():
[36m(WorkerDict pid=218554)[0m     p, k = map(int, input().split()) 
[36m(WorkerDict pid=218554)[0m     # Check if the polynomial exists 
[36m(WorkerDict pid=218554)[0m     if p < k: 
[36m(WorkerDict pid=218554)[0m         # Return the number of coefficients 
