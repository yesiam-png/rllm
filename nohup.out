[36m(WorkerDict pid=914465)[0m     dp = [[0] * (w + 1) for _ in range(h + 1)] 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # There is one way to reach the goal from the start 
[36m(WorkerDict pid=914465)[0m     dp[1][1] = 1 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Iterate through each cell on the board 
[36m(WorkerDict pid=914465)[0m     for i in range(1, h + 1):
[36m(WorkerDict pid=914465)[0m         for j in range(1, w + 1): 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m             # Check if the cell is black 
[36m(WorkerDict pid=914465)[0m             if (i, j) == (1, 1):
[36m(WorkerDict pid=914465)[0m                 continue 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m             # Iterate through all the neighboring cells 
[36m(WorkerDict pid=914465)[0m             for ri, cj in black_cells:
[36m(WorkerDict pid=914465)[0m                 if (i - ri + 1) * (j - cj + 1) > 0: 
[36m(WorkerDict pid=914465)[0m                     # Add the number of ways from the neighboring cell 
[36m(WorkerDict pid=914465)[0m                     dp[i][j] += dp[ri][cj] 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Return the number of ways modulo 10^9 + 7 
[36m(WorkerDict pid=914465)[0m                     dp[i][j] %= 1000000007 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Return the number of ways to reach the goal 
[36m(WorkerDict pid=914465)[0m     return dp[h][w]
