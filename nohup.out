[36m(WorkerDict pid=914465)[0m def solve():
[36m(WorkerDict pid=914465)[0m     n = int(input())
[36m(WorkerDict pid=914465)[0m     edges = [tuple(map(int, input().split())) for _ in range(n-1)]
[36m(WorkerDict pid=914465)[0m 
[36m(WorkerDict pid=914465)[0m     def dfs(node, parent, depth): 
[36m(WorkerDict pid=914465)[0m         # Initialize the maximum depth for the current node 
[36m(WorkerDict pid=914465)[0m         max_depth = depth 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m         # Iterate through all adjacent nodes 
[36m(WorkerDict pid=914465)[0m         for child in range(n): 
[36m(WorkerDict pid=914465)[0m             # Skip the parent node 
[36m(WorkerDict pid=914465)[0m             if child != parent and child != 0: 
[36m(WorkerDict pid=914465)[0m                 # Recur for the adjacent node 
[36m(WorkerDict pid=914465)[0m                 max_depth = max(max_depth, dfs(child, node, depth+edges[node][2])) 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m         # Return the maximum depth for the current node 
[36m(WorkerDict pid=914465)[0m         return max_depth 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Return the maximum depth for the root node 
[36m(WorkerDict pid=914465)[0m 
[36m(WorkerDict pid=914465)[0m     return dfs(0, -1, 0) + 1
