[36m(WorkerDict pid=218555)[0m     right = max(x)
[36m(WorkerDict pid=218555)[0m     l = 0
[36m(WorkerDict pid=218555)[0m     r = n
[36m(WorkerDict pid=218555)[0m     ans = 0
[36m(WorkerDict pid=218555)[0m     while left <= right:
[36m(WorkerDict pid=218555)[0m         m = left + (right - left) // 2
[36m(WorkerDict pid=218555)[0m         if m > d:
[36m(WorkerDict pid=218555)[0m             right = m - 1
[36m(WorkerDict pid=218555)[0m         else:
[36m(WorkerDict pid=218555)[0m             left = m + 1
