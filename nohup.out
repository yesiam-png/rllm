[36m(WorkerDict pid=218556)[0m                 # Append the character to the compressed string 
[36m(WorkerDict pid=218556)[0m                 compressed += char
[36m(WorkerDict pid=218556)[0m             else: 
[36m(WorkerDict pid=218556)[0m                 # Append the character to the compressed string 
[36m(WorkerDict pid=218556)[0m                 compressed += char 
[36m(WorkerDict pid=218556)[0m   
[36m(WorkerDict pid=218556)[0m         # Return the compressed string 
[36m(WorkerDict pid=218556)[0m         return compressed 
