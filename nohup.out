[36m(WorkerDict pid=914465)[0m def solve():
[36m(WorkerDict pid=914465)[0m     n = int(input())
[36m(WorkerDict pid=914465)[0m     s = input()
[36m(WorkerDict pid=914465)[0m     # Initialize the count of sets
[36m(WorkerDict pid=914465)[0m     ans = [0] * (n + 1)  # ans[i] is the count of sets finished with x = i rounds in a row
[36m(WorkerDict pid=914465)[0m 
[36m(WorkerDict pid=914465)[0m     # Iterate through each round
[36m(WorkerDict pid=914465)[0m     for i in range(1, n): 
[36m(WorkerDict pid=914465)[0m         # Check if the current round is played
[36m(WorkerDict pid=914465)[0m         if s[i - 1] == '0': 
[36m(WorkerDict pid=914465)[0m             # Alice won the round, so increment the count
[36m(WorkerDict pid=914465)[0m             ans[i] = ans[i - 1] + 1
[36m(WorkerDict pid=914465)[0m         elif s[i - 1] == '?': 
[36m(WorkerDict pid=914465)[0m             # Bob won the round, so increment the count
[36m(WorkerDict pid=914465)[0m             ans[i] = ans[i - 1] + 1
[36m(WorkerDict pid=914465)[0m         else: 
[36m(WorkerDict pid=914465)[0m             # Alice won the round, so increment the count
[36m(WorkerDict pid=914465)[0m             ans[i] = ans[i - 1]
[36m(WorkerDict pid=914465)[0m     return ans
[36m(WorkerDict pid=914465)[0m 
