[36m(WorkerDict pid=914465)[0m     # Set the first element of the dp array 
[36m(WorkerDict pid=914465)[0m     # Set the first element of dp to 1
[36m(WorkerDict pid=914465)[0m     dp[0] = 1 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Iterate through each black cell 
[36m(WorkerDict pid=914465)[0m     # Iterate over the black cells
[36m(WorkerDict pid=914465)[0m     for r, c in black_cells: 
