[36m(WorkerDict pid=218551)[0m     n = int(input()) 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m     # Create a 2D array to store the numbers 
[36m(WorkerDict pid=218551)[0m     s = [list(map(int, input().split())) for _ in range(n)] 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m     # Initialize the count of winning squares 
[36m(WorkerDict pid=218551)[0m     ans = 0 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m     # Iterate through each square 
[36m(WorkerDict pid=218551)[0m     for i in range(n):
[36m(WorkerDict pid=218551)[0m         col = 0
[36m(WorkerDict pid=218551)[0m         row = 0
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m         # Iterate through each column and row 
[36m(WorkerDict pid=218551)[0m         for j in range(n): 
[36m(WorkerDict pid=218551)[0m             # Add the number to the column sum 
[36m(WorkerDict pid=218551)[0m             col += s[j][i] 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m             # Add the number to the row sum 
[36m(WorkerDict pid=218551)[0m             row += s[i][j] 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m         # Check if the square is winning 
[36m(WorkerDict pid=218551)[0m         if col > row:
[36m(WorkerDict pid=218551)[0m             ans += 1 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m     # Return the count of winning squares 
[36m(WorkerDict pid=218551)[0m     return ans 
