[36m(WorkerDict pid=914465)[0m         if s[i] == '0':
[36m(WorkerDict pid=914465)[0m             res[i] = res[i - 1] + 1
[36m(WorkerDict pid=914465)[0m         else:
[36m(WorkerDict pid=914465)[0m             res[i] = res[i - 1]
[36m(WorkerDict pid=914465)[0m 
