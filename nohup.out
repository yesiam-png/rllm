[36m(WorkerDict pid=218552)[0m                     # Calculate the cost of the partition 
[36m(WorkerDict pid=218552)[0m                     x = a[i:j]
[36m(WorkerDict pid=218552)[0m                     y = a[j:k]
[36m(WorkerDict pid=218552)[0m                     s = sum([abs(x[i]-y[i]) for i in range(n)]) 
[36m(WorkerDict pid=218552)[0m   
[36m(WorkerDict pid=218552)[0m                     # Add the cost to the total cost 
[36m(WorkerDict pid=218552)[0m                     ans += s 
[36m(WorkerDict pid=218552)[0m   
[36m(WorkerDict pid=218552)[0m     # Return the total cost modulo 998244353 
[36m(WorkerDict pid=218552)[0m     return ans % 998244353 
