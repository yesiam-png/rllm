[36m(WorkerDict pid=914214)[0m             ans += (j - i) // C 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m         # Move to the next group of passengers 
[36m(WorkerDict pid=914214)[0m         i = j 
