[36m(WorkerDict pid=914459)[0m         for i in range(1, N - d + 1):
[36m(WorkerDict pid=914459)[0m             j = i + d 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m             # Update the DP table for the current pair 
