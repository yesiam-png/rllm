[36m(WorkerDict pid=914459)[0m def solve():
[36m(WorkerDict pid=914459)[0m     N = int(input()) 
[36m(WorkerDict pid=914459)[0m     
[36m(WorkerDict pid=914459)[0m     # Initialize the minimum number of banknotes 
[36m(WorkerDict pid=914459)[0m     dp = [float('inf')] * (N + 1) 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m     # There is one way to make 0 using no banknotes 
[36m(WorkerDict pid=914459)[0m     dp[0] = 0 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m     # Iterate through all the values up to N 
[36m(WorkerDict pid=914459)[0m     for i in range(1, N + 1): 
[36m(WorkerDict pid=914459)[0m         # Iterate through all possible banknotes 
[36m(WorkerDict pid=914459)[0m         for j in range(1, 10): 
[36m(WorkerDict pid=914459)[0m             # Check if the banknote can be used 
[36m(WorkerDict pid=914459)[0m             if i - j * 10**j >= 0: 
[36m(WorkerDict pid=914459)[0m                 # Update the minimum number of banknotes 
[36m(WorkerDict pid=914459)[0m                 dp[i] = min(dp[i], dp[i - j * 10**j] + 1) 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m     # Return the minimum number of banknotes 
[36m(WorkerDict pid=914459)[0m     return dp[N]
[36m(WorkerDict pid=914459)[0m 
[36m(WorkerDict pid=914459)[0m solve()
