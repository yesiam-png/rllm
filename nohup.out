[36m(WorkerDict pid=1436351)[0m     
[36m(WorkerDict pid=1436351)[0m     def helper(self, nums, i): 
[36m(WorkerDict pid=1436351)[0m         # Initialize the maximum sum to 0 
[36m(WorkerDict pid=1436351)[0m         dp = [0]*len(nums) 
[36m(WorkerDict pid=1436351)[0m   
