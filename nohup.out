[36m(WorkerDict pid=914464)[0m def solve():
[36m(WorkerDict pid=914464)[0m     N = int(input())
[36m(WorkerDict pid=914464)[0m     desks = []
[36m(WorkerDict pid=914464)[0m     for _ in range(N):
[36m(WorkerDict pid=914464)[0m         desks.append([int(x) for x in input().split()])
[36m(WorkerDict pid=914464)[0m     desks.sort(key=lambda x: (x[1], x[0])) 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m     # Initialize the count of possible assignments 
[36m(WorkerDict pid=914464)[0m     result = 1 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m     # Iterate through each desk assignment 
[36m(WorkerDict pid=914464)[0m     seen = {}
[36m(WorkerDict pid=914464)[0m     for i in range(N): 
[36m(WorkerDict pid=914464)[0m         # Check if the desk is already seen 
[36m(WorkerDict pid=914464)[0m         current = desks[i][0]
[36m(WorkerDict pid=914464)[0m         if current in seen: 
[36m(WorkerDict pid=914464)[0m             # Skip the desk if seen before 
[36m(WorkerDict pid=914464)[0m             continue 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m         # Mark the desk as seen 
[36m(WorkerDict pid=914464)[0m         for j in range(N):
[36m(WorkerDict pid=914464)[0m             if j > i and desks[j][0] == current:
[36m(WorkerDict pid=914464)[0m                 break
[36m(WorkerDict pid=914464)[0m         for j in range(N):
[36m(WorkerDict pid=914464)[0m             if j > i and desks[j][1] == current and not (j > i and (desks[j][0] == current and desks[j][1] == current)):
[36m(WorkerDict pid=914464)[0m                 break
[36m(WorkerDict pid=914464)[0m         else: 
[36m(WorkerDict pid=914464)[0m             # Increment the count of possible assignments 
[36m(WorkerDict pid=914464)[0m             seen[current] = True
[36m(WorkerDict pid=914464)[0m             result += 1 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m     # Return the count of possible assignments 
[36m(WorkerDict pid=914464)[0m     print(result)
[36m(WorkerDict pid=914464)[0m 
