[36m(WorkerDict pid=218553)[0m     arr = list(map(int, input().split()))
[36m(WorkerDict pid=218553)[0m     # Create a list to store the ends of the increasing subsequences
[36m(WorkerDict pid=218553)[0m     dp = [1] * (n * t) 
[36m(WorkerDict pid=218553)[0m   
[36m(WorkerDict pid=218553)[0m     # Iterate through the array to fill the DP list
[36m(WorkerDict pid=218553)[0m     for i in range(1, n * t): 
[36m(WorkerDict pid=218553)[0m         # Iterate through the previous elements
[36m(WorkerDict pid=218553)[0m         for j in range(i): 
[36m(WorkerDict pid=218553)[0m             # Check if the current element is greater than the previous one
[36m(WorkerDict pid=218553)[0m             if arr[i] >= arr[j]: 
[36m(WorkerDict pid=218553)[0m                 # Update the end of the increasing subsequence
[36m(WorkerDict pid=218553)[0m                 dp[i] = max(dp[i], dp[j] + 1) 
[36m(WorkerDict pid=218553)[0m   
[36m(WorkerDict pid=218553)[0m     # Return the maximum length of the subsequence
[36m(WorkerDict pid=218553)[0m     return max(dp) 
