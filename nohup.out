[36m(WorkerDict pid=218554)[0m   
[36m(WorkerDict pid=218554)[0m     # Sort the array in ascending order 
[36m(WorkerDict pid=218554)[0m     dp = [0]*n 
[36m(WorkerDict pid=218554)[0m   
[36m(WorkerDict pid=218554)[0m     # Initialize the first element as 0 
[36m(WorkerDict pid=218554)[0m     dp[0] = a[0] 
[36m(WorkerDict pid=218554)[0m   
[36m(WorkerDict pid=218554)[0m     # Iterate through the array starting from the second element 
[36m(WorkerDict pid=218554)[0m     for i in range(1, n): 
[36m(WorkerDict pid=218554)[0m         # Update the maximum happiness for each element 
[36m(WorkerDict pid=218554)[0m         dp[i] = max(dp[i-1], (i-1)*a[i] + dp[i-1], (i+1)*a[i] - dp[i-1]) 
[36m(WorkerDict pid=218554)[0m   
[36m(WorkerDict pid=218554)[0m     # Return the maximum happiness value 
[36m(WorkerDict pid=218554)[0m     return dp[-1] 
