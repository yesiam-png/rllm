[36m(WorkerDict pid=218554)[0m afterremove def solve():
[36m(WorkerDict pid=218554)[0m     n = int(input())
[36m(WorkerDict pid=218554)[0m     adj_list = [set() for i in range(n+1)] 
[36m(WorkerDict pid=218554)[0m   
[36m(WorkerDict pid=218554)[0m     # Iterate through all the connections 
[36m(WorkerDict pid=218554)[0m     for i in range(n):
[36m(WorkerDict pid=218554)[0m         adj_list[int(input())].add(i+1) 
[36m(WorkerDict pid=218554)[0m   
[36m(WorkerDict pid=218554)[0m     # Initialize the number of friends for Bob 
[36m(WorkerDict pid=218554)[0m     friends = {} 
[36m(WorkerDict pid=218554)[0m   
[36m(WorkerDict pid=218554)[0m     # Iterate through all the connections 
[36m(WorkerDict pid=218554)[0m     for i in range(1, n+1): 
[36m(WorkerDict pid=218554)[0m         # Iterate through all the connections 
[36m(WorkerDict pid=218554)[0m         for j in adj_list[i]: 
[36m(WorkerDict pid=218554)[0m             # Add the friend to the dictionary 
[36m(WorkerDict pid=218554)[0m             friends[j] = True 
[36m(WorkerDict pid=218554)[0m   
[36m(WorkerDict pid=218554)[0m     # Return the number of friends for Bob 
[36m(WorkerDict pid=218554)[0m     return max([len(adj_list[i]) for i in range(1, n+1) if i not in friends]) 
