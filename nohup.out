[36m(WorkerDict pid=218555)[0m afterremove def solve():
[36m(WorkerDict pid=218555)[0m     # Read the number of tweets and clicks
[36m(WorkerDict pid=218555)[0m     n, k = map(int, input().split()) 
[36m(WorkerDict pid=218555)[0m   
[36m(WorkerDict pid=218555)[0m     # Initialize the count of open tweets 
[36m(WorkerDict pid=218555)[0m     open_tweets = [0] * (n + 1) 
[36m(WorkerDict pid=218555)[0m   
[36m(WorkerDict pid=218555)[0m     # Iterate through each click 
[36m(WorkerDict pid=218555)[0m     open_count = 0
[36m(WorkerDict pid=218555)[0m     for _ in range(k): 
[36m(WorkerDict pid=218555)[0m         # Read the type of click 
[36m(WorkerDict pid=218555)[0m         cmd = input().split()[0] 
[36m(WorkerDict pid=218555)[0m   
[36m(WorkerDict pid=218555)[0m         # If it's a click on a tweet 
[36m(WorkerDict pid=218555)[0m         if cmd == "CLICK": 
[36m(WorkerDict pid=218555)[0m             # Update the count of open tweets 
[36m(WorkerDict pid=218555)[0m             tweet = int(input())
[36m(WorkerDict pid=218555)[0m             if open_tweets[tweet] == 0:
[36m(WorkerDict pid=218555)[0m                 open_tweets[tweet] = 1
[36m(WorkerDict pid=218555)[0m                 open_count += 1
[36m(WorkerDict pid=218555)[0m             else:
[36m(WorkerDict pid=218555)[0m                 open_tweets[tweet] = 0
[36m(WorkerDict pid=218555)[0m         # If it's a close all tweets 
[36m(WorkerDict pid=218555)[0m                 open_count -= 1
[36m(WorkerDict pid=218555)[0m         # Otherwise, close all the open tweets 
[36m(WorkerDict pid=218555)[0m         elif cmd == "CLOSEALL":
[36m(WorkerDict pid=218555)[0m             open_tweets = [0] * (n + 1)
[36m(WorkerDict pid=218555)[0m             open_count = 0 
[36m(WorkerDict pid=218555)[0m   
[36m(WorkerDict pid=218555)[0m     # Print the final count of open tweets 
