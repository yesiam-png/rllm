[36m(WorkerDict pid=336672)[0m def solve():
[36m(WorkerDict pid=336672)[0m     # Convert velocity from km/h to m/s
[36m(WorkerDict pid=336672)[0m     g = 9.81
[36m(WorkerDict pid=336672)[0m     v = 15 # km/h
[36m(WorkerDict pid=336672)[0m     
[36m(WorkerDict pid=336672)[0m     # Initialize the maximum height and time
[36m(WorkerDict pid=336672)[0m     v_m_per_s = v / 3.6
[36m(WorkerDict pid=336672)[0m     max_tenth = 0
[36m(WorkerDict pid=336672)[0m     
[36m(WorkerDict pid=336672)[0m     # Iterate through each recording
[36m(WorkerDict pid=336672)[0m     max_height = 0
[36m(WorkerDict pid=336672)[0m     for t in range(0, 1000, 10): 
[36m(WorkerDict pid=336672)[0m         # Calculate the height at the current time 
[36m(WorkerDict pid=336672)[0m         h = v_m_per_s * t - 0.5 * g * t * t 
[36m(WorkerDict pid=336672)[0m   
[36m(WorkerDict pid=336672)[0m         # Update the maximum height and time
[36m(WorkerDict pid=336672)[0m         if h > max_height:
[36m(WorkerDict pid=336672)[0m             max_height = h
[36m(WorkerDict pid=336672)[0m             max_tenth = t / 10 
[36m(WorkerDict pid=336672)[0m   
[36m(WorkerDict pid=336672)[0m     # Return the maximum time 
[36m(WorkerDict pid=336672)[0m     return max_tenth
