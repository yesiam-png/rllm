[36m(WorkerDict pid=218551)[0m     p, d = map(int, input().split()) 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m     # Iterate until the price is within bounds 
[36m(WorkerDict pid=218551)[0m     while d > 0: 
[36m(WorkerDict pid=218551)[0m         # Check if the price is within bounds 
[36m(WorkerDict pid=218551)[0m         if p % 10 == 9: 
[36m(WorkerDict pid=218551)[0m             # Update the price and reduce d 
[36m(WorkerDict pid=218551)[0m             p //= 10
[36m(WorkerDict pid=218551)[0m             d -= 1
[36m(WorkerDict pid=218551)[0m         else: 
[36m(WorkerDict pid=218551)[0m             # Move to the next digit 
[36m(WorkerDict pid=218551)[0m             p -= 1
[36m(WorkerDict pid=218551)[0m             d = max(d - 1, 0) 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m     # Return the final price 
[36m(WorkerDict pid=218551)[0m     return p 
