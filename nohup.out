[36m(WorkerDict pid=914214)[0m 
[36m(WorkerDict pid=914214)[0m def solve():
[36m(WorkerDict pid=914214)[0m     # Read the number of passengers and capacity
[36m(WorkerDict pid=914214)[0m     N, C, K = map(int, input().split()) 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m     # Read the arrival times of passengers 
[36m(WorkerDict pid=914214)[0m     T = [int(input()) for _ in range(N)] 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m     # Sort the arrival times 
[36m(WorkerDict pid=914214)[0m     T.sort() 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m     # Initialize the number of buses to 0 
[36m(WorkerDict pid=914214)[0m     ans = 0 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m     # Iterate through each passenger 
[36m(WorkerDict pid=914214)[0m     i = 0
[36m(WorkerDict pid=914214)[0m     while i < N: 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m         # Initialize the number of buses for this group 
[36m(WorkerDict pid=914214)[0m         if T[i] + K >= T[N - 1]: 
[36m(WorkerDict pid=914214)[0m             # Break out of the loop as it is valid 
[36m(WorkerDict pid=914214)[0m             break 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m         # Add a bus for this group 
[36m(WorkerDict pid=914214)[0m         j = i + 1
[36m(WorkerDict pid=914214)[0m         while j < N and T[j] - T[i] <= K:
[36m(WorkerDict pid=914214)[0m             j += 1 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m         # Update the number of buses for this group 
[36m(WorkerDict pid=914214)[0m         if (j - i) > C: 
[36m(WorkerDict pid=914214)[0m             # Break out of the loop as it is invalid 
[36m(WorkerDict pid=914214)[0m             ans += 1 
[36m(WorkerDict pid=914214)[0m   
