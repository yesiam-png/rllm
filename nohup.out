[36m(WorkerDict pid=914214)[0m         # Check if the next arrival time is within the window 
[36m(WorkerDict pid=914214)[0m         if T[i] - current_time >= K: 
[36m(WorkerDict pid=914214)[0m             # Increment the count of buses needed 
[36m(WorkerDict pid=914214)[0m             buses += 1
[36m(WorkerDict pid=914214)[0m             # Update the current time to the next arrival time 
[36m(WorkerDict pid=914214)[0m             current_time = T[i] 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m     # Return the total number of buses needed 
[36m(WorkerDict pid=914214)[0m 
[36m(WorkerDict pid=914214)[0m     return buses
