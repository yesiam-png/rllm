[36m(WorkerDict pid=914464)[0m def solve():
[36m(WorkerDict pid=914464)[0m     n = int(input()) 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m     # Dictionary to store the color and sum of values 
[36m(WorkerDict pid=914464)[0m     colors = [int(input()) for _ in range(n)] 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m     # Dictionary to store the sum of values for each node 
[36m(WorkerDict pid=914464)[0m     sums = [int(input()) for _ in range(n)] 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m     # List to store the edges of the tree 
[36m(WorkerDict pid=914464)[0m     edges = [] 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m     # Iterate through each node 
[36m(WorkerDict pid=914464)[0m     for i in range(n): 
[36m(WorkerDict pid=914464)[0m         # Iterate through each edge connected to the node 
[36m(WorkerDict pid=914464)[0m         for j in range(i+1, n): 
[36m(WorkerDict pid=914464)[0m             # Check if the edge connects the nodes 
[36m(WorkerDict pid=914464)[0m             if colors[i] != colors[j] and sums[i] + sums[j] == sums[i] + sums[j] - edges[i][j]: 
[36m(WorkerDict pid=914464)[0m                 # Add the edge to the list 
[36m(WorkerDict pid=914464)[0m                 edges.append([i+1, j+1, edges[i][j]]) 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m     # Return the list of edges 
[36m(WorkerDict pid=914464)[0m     edges.sort(key=lambda x: x[2]) 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m     # Iterate through the edges 
[36m(WorkerDict pid=914464)[0m     for edge in edges: 
[36m(WorkerDict pid=914464)[0m         # Print the edge to the output 
[36m(WorkerDict pid=914464)[0m         print(*edge)
