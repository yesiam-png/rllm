[36m(WorkerDict pid=914459)[0m def solve():
[36m(WorkerDict pid=914459)[0m     n = int(input())
[36m(WorkerDict pid=914459)[0m     grades = [int(i) for i in input().split()] 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m     # Calculate the current average grade 
[36m(WorkerDict pid=914459)[0m     grades.sort(reverse=True) 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m     # Initialize the total sum of grades 
[36m(WorkerDict pid=914459)[0m     mid = 4.5 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m     # Initialize the total sum of grades 
[36m(WorkerDict pid=914459)[0m     for grade in grades: 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m         # Check if the grade is below mid 
[36m(WorkerDict pid=914459)[0m         if grade >= mid: 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m             # Break out of the loop 
[36m(WorkerDict pid=914459)[0m             n -= 1 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m             # Break out of the loop 
[36m(WorkerDict pid=914459)[0m         mid += 0.5 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m     # Return the minimum number of grades to redo 
[36m(WorkerDict pid=914459)[0m     return n
