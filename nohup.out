[36m(WorkerDict pid=1436351)[0m class Solution:
[36m(WorkerDict pid=1436351)[0m     def maxBalancedSubsequenceSum(self, nums: List[int]) -> int:
[36m(WorkerDict pid=1436351)[0m         n = len(nums) 
[36m(WorkerDict pid=1436351)[0m         # Create a list to store the prefix sums 
[36m(WorkerDict pid=1436351)[0m         dp = [0] * (n + 1) 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m         # Iterate through each number in the array 
[36m(WorkerDict pid=1436351)[0m         dp[1] = nums[0] 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m         # Iterate through the remaining numbers 
[36m(WorkerDict pid=1436351)[0m         ans = 0
[36m(WorkerDict pid=1436351)[0m         for i in range(2, n + 1): 
[36m(WorkerDict pid=1436351)[0m             # Iterate through all previous numbers 
[36m(WorkerDict pid=1436351)[0m             dp[i] = max(dp[i - 1], nums[i - 1]) 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m             # Iterate through all previous numbers 
[36m(WorkerDict pid=1436351)[0m             for j in range(1, i): 
[36m(WorkerDict pid=1436351)[0m                 # Check if the condition is satisfied 
[36m(WorkerDict pid=1436351)[0m                 if nums[j - 1] - j + 1 >= i - j: 
[36m(WorkerDict pid=1436351)[0m                     # Update the maximum sum 
[36m(WorkerDict pid=1436351)[0m                     dp[i] = max(dp[i], dp[j - 1] + nums[i - 1]) 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m             # Update the maximum sum found so far 
[36m(WorkerDict pid=1436351)[0m             ans = max(ans, dp[i]) 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m         # Return the maximum sum found 
[36m(WorkerDict pid=1436351)[0m         return ans
