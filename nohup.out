[36m(WorkerDict pid=914464)[0m         else: 
[36m(WorkerDict pid=914464)[0m             # Mark the node as black 
[36m(WorkerDict pid=914464)[0m             colors[i] = 0 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m     # Iterate through the nodes 
[36m(WorkerDict pid=914464)[0m     for i in range(n): 
[36m(WorkerDict pid=914464)[0m         # Read the color and sum of the node 
