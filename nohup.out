[36m(WorkerDict pid=914464)[0m     # Initialize the set of points to be connected
[36m(WorkerDict pid=914464)[0m     for x1, y1 in points: 
[36m(WorkerDict pid=914464)[0m         # Initialize the set of connected points
[36m(WorkerDict pid=914464)[0m         for x2, y2 in points: 
[36m(WorkerDict pid=914464)[0m             # Check if the points are connected
[36m(WorkerDict pid=914464)[0m             if (y1, y2) not in ((y2, y1), (y1, y2)): 
[36m(WorkerDict pid=914464)[0m                 # Add the edge to the minimum cost
[36m(WorkerDict pid=914464)[0m                 ans += abs(x1 - x2) * (y1 - y2)
[36m(WorkerDict pid=914464)[0m     print(ans)
