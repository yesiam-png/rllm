[36m(WorkerDict pid=336673)[0m     def move(pos, direction, size):
[36m(WorkerDict pid=336673)[0m         x, y = pos
[36m(WorkerDict pid=336673)[0m         if direction == 'left':
[36m(WorkerDict pid=336673)[0m             x, y = (x+1) % size, (y-1) % size
[36m(WorkerDict pid=336673)[0m         elif direction == 'right':
[36m(WorkerDict pid=336673)[0m             x, y = (x-1) % size, (y+1) % size
[36m(WorkerDict pid=336673)[0m         elif direction == 'up':
[36m(WorkerDict pid=336673)[0m             x, y = (x-1) % size, (y+1) % size
[36m(WorkerDict pid=336673)[0m         elif direction == 'down':
[36m(WorkerDict pid=336673)[0m             x, y = (x+1) % size, (y-1) % size
[36m(WorkerDict pid=336673)[0m         return x, y
[36m(WorkerDict pid=336673)[0m 
[36m(WorkerDict pid=336673)[0m     size = 1
[36m(WorkerDict pid=336673)[0m     while True:
[36m(WorkerDict pid=336673)[0m         pos = (0, 0)
[36m(WorkerDict pid=336673)[0m         for _ in range(1000):
[36m(WorkerDict pid=336673)[0m             pos = move(pos, 'up' if size % 2 == 0 else 'down', size)
[36m(WorkerDict pid=336673)[0m             if pos == (0, 0):
[36m(WorkerDict pid=336673)[0m                 return size
[36m(WorkerDict pid=336673)[0m             size += 1
