[36m(WorkerDict pid=914465)[0m def solve():
[36m(WorkerDict pid=914465)[0m     n = int(input())
[36m(WorkerDict pid=914465)[0m     events = [[int(x) for x in input().split()] for _ in range(n)] 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Sort the events based on their start time 
[36m(WorkerDict pid=914465)[0m     events.sort(key=lambda x: x[1]) 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Initialize the result list 
[36m(WorkerDict pid=914465)[0m     ans = [] 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Iterate through each event 
[36m(WorkerDict pid=914465)[0m     for event in events: 
[36m(WorkerDict pid=914465)[0m         # Add the event to the result list 
[36m(WorkerDict pid=914465)[0m         if not ans or ans[-1] != event[0]:
[36m(WorkerDict pid=914465)[0m             ans.append(event[0]) 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Return the final result list 
[36m(WorkerDict pid=914465)[0m     return ans
