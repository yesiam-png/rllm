[36m(WorkerDict pid=218552)[0m             # Increment the count if found 
[36m(WorkerDict pid=218552)[0m             count += 1 
[36m(WorkerDict pid=218552)[0m   
[36m(WorkerDict pid=218552)[0m     # Return the final count 
