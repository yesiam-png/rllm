[36m(WorkerDict pid=218551)[0m 2 6
[36m(WorkerDict pid=218551)[0m 3 4
[36m(WorkerDict pid=218551)[0m 3 5
[36m(WorkerDict pid=218551)[0m 3 6
[36m(WorkerDict pid=218551)[0m 
[36m(WorkerDict pid=218551)[0m afterremove def solve():
[36m(WorkerDict pid=218551)[0m     n, p = map(int, input().split())
