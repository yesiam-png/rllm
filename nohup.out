[36m(WorkerDict pid=1436351)[0m     def sumDigitDifferences(self, nums: List[int]) -> int:
[36m(WorkerDict pid=1436351)[0m         ans = 0
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Iterate through each number in the list
[36m(WorkerDict pid=1436351)[0m         for i in range(len(nums)-1): 
[36m(WorkerDict pid=1436351)[0m             # Iterate through the remaining numbers
[36m(WorkerDict pid=1436351)[0m             for j in range(i+1, len(nums)): 
[36m(WorkerDict pid=1436351)[0m                 # Calculate the digit difference
[36m(WorkerDict pid=1436351)[0m                 count = 0
[36m(WorkerDict pid=1436351)[0m                 for k in range(len(str(nums[i]))) : 
[36m(WorkerDict pid=1436351)[0m                     # Check if the digits are different
[36m(WorkerDict pid=1436351)[0m                     if str(nums[i])[k] != str(nums[j])[k] :
[36m(WorkerDict pid=1436351)[0m                         count += 1
[36m(WorkerDict pid=1436351)[0m                 
[36m(WorkerDict pid=1436351)[0m                 # Add the count to the total sum
[36m(WorkerDict pid=1436351)[0m                 ans += count 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m         # Return the final sum
[36m(WorkerDict pid=1436351)[0m         return ans
