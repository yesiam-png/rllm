[36m(WorkerDict pid=218553)[0m A single line which contains YES or NO in uppercase.
[36m(WorkerDict pid=218553)[0m 
[36m(WorkerDict pid=218553)[0m SAMPLE INPUT
[36m(WorkerDict pid=218553)[0m aaabbbb
[36m(WorkerDict pid=218553)[0m 
[36m(WorkerDict pid=218553)[0m SAMPLE OUTPUT
[36m(WorkerDict pid=218553)[0m YES
[36m(WorkerDict pid=218553)[0m 
