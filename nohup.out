[36m(WorkerDict pid=1436351)[0m class Solution:
[36m(WorkerDict pid=1436351)[0m     def minimumBoxes(self, apple: List[int], capacity: List[int]) -> int:
[36m(WorkerDict pid=1436351)[0m         # Sort the capacity in descending order
[36m(WorkerDict pid=1436351)[0m         capacity.sort(reverse=True) 
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Initialize the count of boxes needed
[36m(WorkerDict pid=1436351)[0m         total_apples = sum(apple)
[36m(WorkerDict pid=1436351)[0m         total_capacity = 0 
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Iterate through each box capacity
[36m(WorkerDict pid=1436351)[0m         boxes = 0
[36m(WorkerDict pid=1436351)[0m         for c in capacity: 
[36m(WorkerDict pid=1436351)[0m             # Add the capacity to the total
[36m(WorkerDict pid=1436351)[0m             total_capacity += c 
[36m(WorkerDict pid=1436351)[0m             # Increment the count of boxes needed
[36m(WorkerDict pid=1436351)[0m             total_apples -= c 
[36m(WorkerDict pid=1436351)[0m             # Break if all apples are distributed
[36m(WorkerDict pid=1436351)[0m             if total_apples <= 0:
[36m(WorkerDict pid=1436351)[0m                 break 
[36m(WorkerDict pid=1436351)[0m             # Increment the count of boxes
[36m(WorkerDict pid=1436351)[0m             boxes += 1 
