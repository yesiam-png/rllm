[36m(WorkerDict pid=1436351)[0m             max_val = max(max_val, product) 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m         # Return the maximum value found
[36m(WorkerDict pid=1436351)[0m 
[36m(WorkerDict pid=1436351)[0m         return max_val % (10**9 + 7)
