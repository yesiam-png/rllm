[36m(WorkerDict pid=914214)[0m     def power_law(x1y1, x2y2, x3): 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m         # Calculate the ratio of y to x 
[36m(WorkerDict pid=914214)[0m         slope = (x2y2[1] - x1y1[1]) / (x2y2[0] - x1y1[0]) 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m         # Calculate the y value for the given x 
[36m(WorkerDict pid=914214)[0m         intercept = x1y1[1] - slope * x1y1[0] 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m         # Return the calculated y value 
[36m(WorkerDict pid=914214)[0m         y3 = slope * x3 + intercept
[36m(WorkerDict pid=914214)[0m         return round(y3) 
