[36m(WorkerDict pid=1436351)[0m class Solution:
[36m(WorkerDict pid=1436351)[0m     def numberOfWays(self, s: str, t: str, k: int) -> int:
[36m(WorkerDict pid=1436351)[0m         lcs = [[0] * (len(s)+1) for _ in range(len(t)+1)] 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m         # Iterate through both strings to compute LCS 
[36m(WorkerDict pid=1436351)[0m         for i in range(1, len(t)+1):
[36m(WorkerDict pid=1436351)[0m             for j in range(1, len(s)+1): 
[36m(WorkerDict pid=1436351)[0m                 # If characters match, increment count 
[36m(WorkerDict pid=1436351)[0m                 if s[j-1] == t[i-1]:
[36m(WorkerDict pid=1436351)[0m                     lcs[i][j] = lcs[i-1][j-1] + 1 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m                 # Otherwise, take the maximum count 
[36m(WorkerDict pid=1436351)[0m                 else:
[36m(WorkerDict pid=1436351)[0m                     lcs[i][j] = max(lcs[i][j-1], lcs[i-1][j]) 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m         # Initialize count to store the result 
[36m(WorkerDict pid=1436351)[0m         def count(lcs, s, t, k, j, i, ways): 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m             # If k becomes zero, return the count 
[36m(WorkerDict pid=1436351)[0m             if k == 0:
[36m(WorkerDict pid=1436351)[0m                 return ways 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m             # If j reaches the end of s 
[36m(WorkerDict pid=1436351)[0m             if i == len(s):
[36m(WorkerDict pid=1436351)[0m                 return ways 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m             # If i reaches the end of t 
[36m(WorkerDict pid=1436351)[0m             if j == len(t):
[36m(WorkerDict pid=1436351)[0m                 return ways 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m             # Check if the result is already computed 
[36m(WorkerDict pid=1436351)[0m             if lcs[i][j] >= k:
[36m(WorkerDict pid=1436351)[0m                 ways += count(lcs, s, t, k-lcs[i][j], j, i+1, ways) 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m             # Move to the next character in t 
[36m(WorkerDict pid=1436351)[0m             ways += count(lcs, s, t, k, j+1, i, ways) 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m             # Return the updated count 
[36m(WorkerDict pid=1436351)[0m             return ways 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m         # Return the final count 
[36m(WorkerDict pid=1436351)[0m         return count(lcs, s, t, k, 0, 0, 0)
