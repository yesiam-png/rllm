[36m(WorkerDict pid=218551)[0m afterremove def solve():
[36m(WorkerDict pid=218551)[0m     n = int(input())
[36m(WorkerDict pid=218551)[0m     for i in range(n):
[36m(WorkerDict pid=218551)[0m         scores = list(map(int, input().split()))
[36m(WorkerDict pid=218551)[0m         k = int(input())
[36m(WorkerDict pid=218551)[0m         # Write your code here
[36m(WorkerDict pid=218551)[0m         scores.sort()
[36m(WorkerDict pid=218551)[0m         ways = 0
[36m(WorkerDict pid=218551)[0m         for i in range(11):
