[36m(WorkerDict pid=218553)[0m 
[36m(WorkerDict pid=218553)[0m afterremove def solve():
[36m(WorkerDict pid=218553)[0m     s = input() 
[36m(WorkerDict pid=218553)[0m   
[36m(WorkerDict pid=218553)[0m     # Count the number of 'a's in the string 
[36m(WorkerDict pid=218553)[0m     max_length = 0 
[36m(WorkerDict pid=218553)[0m   
[36m(WorkerDict pid=218553)[0m     # Iterate through each character in the string 
[36m(WorkerDict pid=218553)[0m     for i in range(len(s)): 
[36m(WorkerDict pid=218553)[0m         # Check if the current character is 'a' 
[36m(WorkerDict pid=218553)[0m         count_a = 0 
[36m(WorkerDict pid=218553)[0m   
[36m(WorkerDict pid=218553)[0m         # Iterate through the remaining characters 
[36m(WorkerDict pid=218553)[0m         for j in range(i, len(s)): 
[36m(WorkerDict pid=218553)[0m             # Check if the current character is 'a' 
[36m(WorkerDict pid=218553)[0m             if s[j] == 'a': 
[36m(WorkerDict pid=218553)[0m                 # Increment the count of 'a's 
[36m(WorkerDict pid=218553)[0m                 count_a += 1 
[36m(WorkerDict pid=218553)[0m   
[36m(WorkerDict pid=218553)[0m             # Check if we have more than half 'a's 
[36m(WorkerDict pid=218553)[0m             if count_a > max_length: 
[36m(WorkerDict pid=218553)[0m                 # Update the maximum length 
[36m(WorkerDict pid=218553)[0m                 max_length = count_a 
[36m(WorkerDict pid=218553)[0m   
[36m(WorkerDict pid=218553)[0m     # Return the maximum length 
[36m(WorkerDict pid=218553)[0m     return max_length 
