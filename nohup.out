[36m(WorkerDict pid=914465)[0m def solve():
[36m(WorkerDict pid=914465)[0m     n = int(input())
[36m(WorkerDict pid=914465)[0m     events = [list(map(int, input().split())) for _ in range(n)] 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Sort the events based on their start date 
[36m(WorkerDict pid=914465)[0m     events.sort(key=lambda x: x[0]) 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Initialize the result list 
