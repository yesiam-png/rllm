[36m(WorkerDict pid=1436351)[0m         # Generate all possible values of x
[36m(WorkerDict pid=1436351)[0m         x = (1 << n) - 1
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Initialize the maximum product
[36m(WorkerDict pid=1436351)[0m         max_val = 0
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Iterate through all possible values of x
[36m(WorkerDict pid=1436351)[0m         for i in range(x + 1): 
[36m(WorkerDict pid=1436351)[0m             # Calculate the value of (a XOR x) and (b XOR x)
