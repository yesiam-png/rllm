[36m(WorkerDict pid=1436351)[0m class Solution:
[36m(WorkerDict pid=1436351)[0m     def sumDigitDifferences(self, nums: List[int]) -> int:
[36m(WorkerDict pid=1436351)[0m         # Create a dictionary to store the digit counts for each number
[36m(WorkerDict pid=1436351)[0m         self.num = nums
[36m(WorkerDict pid=1436351)[0m         self.len = len(nums) 
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Initialize the sum to 0 
[36m(WorkerDict pid=1436351)[0m         self.ans = 0 
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Iterate through each number in the list 
[36m(WorkerDict pid=1436351)[0m         self.d = defaultdict(list) 
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Iterate through each number in the list 
[36m(WorkerDict pid=1436351)[0m         for i in range(self.len): 
[36m(WorkerDict pid=1436351)[0m             # Iterate through each digit in the number 
[36m(WorkerDict pid=1436351)[0m             self.d[len(str(nums[i]))].append(nums[i]) 
[36m(WorkerDict pid=1436351)[0m             
[36m(WorkerDict pid=1436351)[0m         # Iterate through each digit length 
[36m(WorkerDict pid=1436351)[0m         for i in range(1, len(str(nums[0])) + 1): 
[36m(WorkerDict pid=1436351)[0m             # Iterate through each number with the current digit length 
[36m(WorkerDict pid=1436351)[0m             for j in range(len(self.d[i])): 
[36m(WorkerDict pid=1436351)[0m                 # Iterate through each number with the next digit length 
[36m(WorkerDict pid=1436351)[0m                 for k in range(len(self.d[i])): 
[36m(WorkerDict pid=1436351)[0m                     # Check if the numbers are not the same 
[36m(WorkerDict pid=1436351)[0m                     if j != k: 
[36m(WorkerDict pid=1436351)[0m                         # Add the digit difference to the sum 
[36m(WorkerDict pid=1436351)[0m                         self.ans += self.d[i][j] - self.d[i][k] 
[36m(WorkerDict pid=1436351)[0m         # Return the total sum of digit differences 
[36m(WorkerDict pid=1436351)[0m         return self.ans
