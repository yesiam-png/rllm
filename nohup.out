[36m(WorkerDict pid=914464)[0m def solve():
[36m(WorkerDict pid=914464)[0m     N = int(input())
[36m(WorkerDict pid=914464)[0m     F = [list(map(int, input().split())) for _ in range(N)]
[36m(WorkerDict pid=914464)[0m     P = [int(input()) for _ in range(N)]
[36m(WorkerDict pid=914464)[0m     ans = 0
[36m(WorkerDict pid=914464)[0m     # Iterate over all possible combinations of shop openings
[36m(WorkerDict pid=914464)[0m     for i in range(2**N): 
[36m(WorkerDict pid=914464)[0m         # Initialize the profit for the current combination 
[36m(WorkerDict pid=914464)[0m         cnt = 0
[36m(WorkerDict pid=914464)[0m         # Iterate over each shop 
[36m(WorkerDict pid=914464)[0m         for j in range(N): 
[36m(WorkerDict pid=914464)[0m             # Check if the shop is open in the current combination 
[36m(WorkerDict pid=914464)[0m             if (i >> j) & 1: 
[36m(WorkerDict pid=914464)[0m                 # Increment the count of open shops 
[36m(WorkerDict pid=914464)[0m                 cnt += 1 
[36m(WorkerDict pid=914464)[0m         # Check if the current combination is valid 
[36m(WorkerDict pid=914464)[0m         for j in range(N): 
[36m(WorkerDict pid=914464)[0m             # Check if the shop is open in the current combination 
[36m(WorkerDict pid=914464)[0m             for k in range(2): 
[36m(WorkerDict pid=914464)[0m                 # Check if the shop is open in the current combination 
[36m(WorkerDict pid=914464)[0m                 if F[j][k] and (i >> j) & (1 << k): 
[36m(WorkerDict pid=914464)[0m                     # Increment the count of open shops 
[36m(WorkerDict pid=914464)[0m                     cnt -= 1 
[36m(WorkerDict pid=914464)[0m         # Update the maximum profit 
[36m(WorkerDict pid=914464)[0m         if cnt >= 1:
[36m(WorkerDict pid=914464)[0m             ans = max(ans, sum(P[i] for i in range(N) if (i >> j) & (1 << k) for j in range(N) for k in range(2) if F[j][k])) 
[36m(WorkerDict pid=914464)[0m     # Return the maximum profit 
[36m(WorkerDict pid=914464)[0m     print(ans)
[36m(WorkerDict pid=914464)[0m 
