[36m(WorkerDict pid=914465)[0m             if black_cells[i - 1][j - 1][0] == 0:
[36m(WorkerDict pid=914465)[0m                 dp[i][j] += dp[i - 1][j]
[36m(WorkerDict pid=914465)[0m             if black_cells[i - 1][j - 1][1] == 0:
