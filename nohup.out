[36m(WorkerDict pid=218551)[0m afterremove def solve():
[36m(WorkerDict pid=218551)[0m     # Read the number of test cases
[36m(WorkerDict pid=218551)[0m     T = int(input()) 
[36m(WorkerDict pid=218551)[0m     # Iterate through each test case 
[36m(WorkerDict pid=218551)[0m     for _ in range(T): 
[36m(WorkerDict pid=218551)[0m         # Read the scores and K for the current case 
[36m(WorkerDict pid=218551)[0m         scores, K = map(int, input().split()) 
[36m(WorkerDict pid=218551)[0m         # Calculate the maximum possible sum 
[36m(WorkerDict pid=218551)[0m         players = list(map(int, input().split())) 
[36m(WorkerDict pid=218551)[0m         # Calculate the maximum possible sum 
[36m(WorkerDict pid=218551)[0m         players.sort() 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m         # Initialize the maximum sum to 0 
[36m(WorkerDict pid=218551)[0m         count = 0 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m         # Iterate through each player 
[36m(WorkerDict pid=218551)[0m         for i in range(len(players) - K + 1): 
[36m(WorkerDict pid=218551)[0m             # Check if the current sum is maximum 
[36m(WorkerDict pid=218551)[0m             if players[i + K - 1] - players[i] >= K: 
[36m(WorkerDict pid=218551)[0m                 # Increment the count of maximum sums 
[36m(WorkerDict pid=218551)[0m                 count += 1 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m     # Print the number of maximum sums 
[36m(WorkerDict pid=218551)[0m         print(count) 
