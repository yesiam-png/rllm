[36m(WorkerDict pid=914214)[0m         # Initialize the next result list 
[36m(WorkerDict pid=914214)[0m         temp = [1] 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m         # Iterate from 1 to i 
