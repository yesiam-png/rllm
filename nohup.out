[36m(WorkerDict pid=914464)[0m def solve():
[36m(WorkerDict pid=914464)[0m     n = int(input())
[36m(WorkerDict pid=914464)[0m     points = [tuple(map(int, input().split())) for _ in range(n)]
[36m(WorkerDict pid=914464)[0m     points.sort(key=lambda x: x[0])
[36m(WorkerDict pid=914464)[0m 
[36m(WorkerDict pid=914464)[0m 
[36m(WorkerDict pid=914464)[0m     # Initialize the minimum cost to 0
