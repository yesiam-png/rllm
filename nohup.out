[36m(WorkerDict pid=914459)[0m def solve():
[36m(WorkerDict pid=914459)[0m     N, M = map(int, input().split())
[36m(WorkerDict pid=914459)[0m     X, Y, Z = [], [], []
[36m(WorkerDict pid=914459)[0m     for _ in range(M):
[36m(WorkerDict pid=914459)[0m         x, y, z = map(int, input().split())
[36m(WorkerDict pid=914459)[0m         X.append(x)
[36m(WorkerDict pid=914459)[0m         Y.append(y)
[36m(WorkerDict pid=914459)[0m         Z.append(z)
[36m(WorkerDict pid=914459)[0m 
[36m(WorkerDict pid=914459)[0m     dp = [[10 ** 10] * (N + 1) for _ in range(N + 1)]
[36m(WorkerDict pid=914459)[0m     dp[1][1] = 0
[36m(WorkerDict pid=914459)[0m 
[36m(WorkerDict pid=914459)[0m     for i in range(2, N + 1):
[36m(WorkerDict pid=914459)[0m         dp[i][1] = min(dp[i][1], dp[i - 1][1] + 1)
[36m(WorkerDict pid=914459)[0m         for j in range(1, i):
[36m(WorkerDict pid=914459)[0m             dp[i][j + 1] = min(dp[i][j + 1], dp[j][1] + 1)
[36m(WorkerDict pid=914459)[0m             if (i - j) % 2 == 0:
[36m(WorkerDict pid=914459)[0m                 dp[i][j + 1] = min(dp[i][j + 1], dp[i][j] + 1)
[36m(WorkerDict pid=914459)[0m             if (Z[j - 1] + Z[i - 1]) % 2 == 0:
[36m(WorkerDict pid=914459)[0m                 dp[i][j + 1] = min(dp[i][j + 1], dp[i - 1][j] + 1)
[36m(WorkerDict pid=914459)[0m 
[36m(WorkerDict pid=914459)[0m     print(dp[N][1])
