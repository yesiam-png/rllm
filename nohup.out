[36m(WorkerDict pid=218554)[0m         else:
[36m(WorkerDict pid=218554)[0m             dp[i] = dp[i-1] + 2 
[36m(WorkerDict pid=218554)[0m   
[36m(WorkerDict pid=218554)[0m     # Return the number of moves 
[36m(WorkerDict pid=218554)[0m     return dp[n] % 1000000007
