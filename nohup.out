[36m(WorkerDict pid=218555)[0m def solve():
[36m(WorkerDict pid=218555)[0m     # Read the number of students and courses
[36m(WorkerDict pid=218555)[0m     n, m = map(int, input().split()) 
[36m(WorkerDict pid=218555)[0m   
[36m(WorkerDict pid=218555)[0m     # Create a list to store the course scores 
[36m(WorkerDict pid=218555)[0m     seq = list(map(int, input().split())) 
[36m(WorkerDict pid=218555)[0m   
[36m(WorkerDict pid=218555)[0m     # Sort the course scores in ascending order 
[36m(WorkerDict pid=218555)[0m     seq.sort() 
[36m(WorkerDict pid=218555)[0m   
[36m(WorkerDict pid=218555)[0m     # Iterate through the course scores 
[36m(WorkerDict pid=218555)[0m     table = [1] * n 
[36m(WorkerDict pid=218555)[0m   
[36m(WorkerDict pid=218555)[0m     # Iterate through each course score 
[36m(WorkerDict pid=218555)[0m     for i in range(1, n): 
[36m(WorkerDict pid=218555)[0m         # Check if the course score is greater than the previous one 
[36m(WorkerDict pid=218555)[0m         if seq[i] == seq[i-1]: 
[36m(WorkerDict pid=218555)[0m             # Increment the count for the current course score 
[36m(WorkerDict pid=218555)[0m             continue 
[36m(WorkerDict pid=218555)[0m   
[36m(WorkerDict pid=218555)[0m         # Update the count for the current course score 
[36m(WorkerDict pid=218555)[0m         else: 
[36m(WorkerDict pid=218555)[0m             # Update the count for the current course score 
[36m(WorkerDict pid=218555)[0m             table[i] = table[i-1] + 1 
[36m(WorkerDict pid=218555)[0m   
[36m(WorkerDict pid=218555)[0m     # Return the list of counts 
[36m(WorkerDict pid=218555)[0m     print(n, m) 
[36m(WorkerDict pid=218555)[0m   
[36m(WorkerDict pid=218555)[0m     # Print the counts of each course score 
[36m(WorkerDict pid=218555)[0m     for i in range(n):
[36m(WorkerDict pid=218555)[0m         print(table[i], end=' ')
