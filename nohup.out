[36m(WorkerDict pid=1436351)[0m             # Update the maximum sum at the current index 
[36m(WorkerDict pid=1436351)[0m             dp[j] = max(diff, diff_plus) 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m         # Return the maximum sum 
