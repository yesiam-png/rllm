[36m(WorkerDict pid=914459)[0m def solve():
[36m(WorkerDict pid=914459)[0m     n = int(input())
[36m(WorkerDict pid=914459)[0m     grades = list(map(int, input().split()))
[36m(WorkerDict pid=914459)[0m 
[36m(WorkerDict pid=914459)[0m     sum = 0
[36m(WorkerDict pid=914459)[0m     cnt = 0
[36m(WorkerDict pid=914459)[0m     for grade in grades:
[36m(WorkerDict pid=914459)[0m         if grade == 5:
[36m(WorkerDict pid=914459)[0m             cnt += 1
[36m(WorkerDict pid=914459)[0m         sum += grade
[36m(WorkerDict pid=914459)[0m 
[36m(WorkerDict pid=914459)[0m     if cnt == 0:
