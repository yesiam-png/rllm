[36m(WorkerDict pid=914214)[0m     # Initialize the list to store results 
[36m(WorkerDict pid=914214)[0m     res = [1, 1] 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m     # Iterate from 1 to n 
