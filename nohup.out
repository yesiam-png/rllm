[36m(WorkerDict pid=218551)[0m         col_sum = 0 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m         # Iterate through each number in the square 
[36m(WorkerDict pid=218551)[0m         for j in range(n): 
[36m(WorkerDict pid=218551)[0m             # Add the number to the row and column sums 
[36m(WorkerDict pid=218551)[0m             row_sum += matrix[i][j]
[36m(WorkerDict pid=218551)[0m             col_sum += matrix[j][i] 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m         # Add the row and column sums to the total sum 
[36m(WorkerDict pid=218551)[0m         total_sum += max(row_sum, col_sum) 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m     # Return the count of winning squares 
[36m(WorkerDict pid=218551)[0m     return total_sum
