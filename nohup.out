[36m(WorkerDict pid=914459)[0m 
[36m(WorkerDict pid=914459)[0m     def solution(costs): 
[36m(WorkerDict pid=914459)[0m         # Sort the costs in descending order 
[36m(WorkerDict pid=914459)[0m         costs.sort(reverse=True) 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m         # Initialize the result list 
[36m(WorkerDict pid=914459)[0m         return sum(costs) 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m     # Return the maximum cost 
[36m(WorkerDict pid=914459)[0m 
[36m(WorkerDict pid=914459)[0m     def rec(costs, points, index): 
[36m(WorkerDict pid=914459)[0m         # Base case: All costs have been considered 
[36m(WorkerDict pid=914459)[0m         if index == 0:
[36m(WorkerDict pid=914459)[0m             return points 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m         # Initialize the result variable 
[36m(WorkerDict pid=914459)[0m         for i in range(index, len(costs)): 
[36m(WorkerDict pid=914459)[0m             # Update the points and index 
[36m(WorkerDict pid=914459)[0m             if costs[i] > 0 and i == index:
[36m(WorkerDict pid=914459)[0m                 return rec(costs, points * costs[i], i + 1) 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m         # Return the maximum cost 
[36m(WorkerDict pid=914459)[0m             if costs[i] > 0 and i > index:
[36m(WorkerDict pid=914459)[0m                 return rec(costs, points * costs[i], i + 1) 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m         # Return the maximum cost 
[36m(WorkerDict pid=914459)[0m         return points 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m     # Return the maximum cost 
[36m(WorkerDict pid=914459)[0m 
[36m(WorkerDict pid=914459)[0m     print(solution(c))
