[36m(WorkerDict pid=914459)[0m def solve():
[36m(WorkerDict pid=914459)[0m     n, m = map(int, input().split())
[36m(WorkerDict pid=914459)[0m     x, y, z = [], [], []
[36m(WorkerDict pid=914459)[0m     for i in range(m):
[36m(WorkerDict pid=914459)[0m         a, b, c = map(int, input().split())
[36m(WorkerDict pid=914459)[0m         x.append(a - 1)
[36m(WorkerDict pid=914459)[0m         y.append(b - 1)
[36m(WorkerDict pid=914459)[0m         z.append(c)
[36m(WorkerDict pid=914459)[0m     x.sort()
[36m(WorkerDict pid=914459)[0m     y.sort()
[36m(WorkerDict pid=914459)[0m     z.sort()
[36m(WorkerDict pid=914459)[0m     diff = 0
[36m(WorkerDict pid=914459)[0m     for i in range(m):
[36m(WorkerDict pid=914459)[0m         if x[i] != y[i]:
[36m(WorkerDict pid=914459)[0m             diff += 1
[36m(WorkerDict pid=914459)[0m     if diff == 0:
[36m(WorkerDict pid=914459)[0m         return n
[36m(WorkerDict pid=914459)[0m     elif diff == 1:
[36m(WorkerDict pid=914459)[0m         return n + 1
[36m(WorkerDict pid=914459)[0m     else:
[36m(WorkerDict pid=914459)[0m         return n + 2
