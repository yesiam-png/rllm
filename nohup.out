[36m(WorkerDict pid=914465)[0m def solve():
[36m(WorkerDict pid=914465)[0m     p, q, l, r = map(int, input().split())
[36m(WorkerDict pid=914465)[0m     a, b = [map(int, input().split()) for _ in range(p)]
[36m(WorkerDict pid=914465)[0m     c, d = [map(int, input().split()) for _ in range(q)] 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Count the number of valid moments 
[36m(WorkerDict pid=914465)[0m     ans = 0 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Iterate through all possible moments 
[36m(WorkerDict pid=914465)[0m     for t in range(l, r + 1): 
[36m(WorkerDict pid=914465)[0m         # Check if they have a common moment 
[36m(WorkerDict pid=914465)[0m         if any(0 <= a[i] + t < b[i] for i in range(p)) and any(0 <= c[j] + t < d[j] for j in range(q)):
[36m(WorkerDict pid=914465)[0m             ans += 1 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Return the count of valid moments 
[36m(WorkerDict pid=914465)[0m     print(ans)
