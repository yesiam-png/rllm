[36m(WorkerDict pid=1436351)[0m class Solution:
[36m(WorkerDict pid=1436351)[0m     def furthestDistanceFromOrigin(self, moves: str) -> int:
[36m(WorkerDict pid=1436351)[0m         left = right = 0
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Count the number of 'L' and 'R' moves
[36m(WorkerDict pid=1436351)[0m         for c in moves:
[36m(WorkerDict pid=1436351)[0m             if c == 'L':
[36m(WorkerDict pid=1436351)[0m                 left += 1
[36m(WorkerDict pid=1436351)[0m             elif c == 'R':
[36m(WorkerDict pid=1436351)[0m                 right += 1
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Return the maximum of the two counts
[36m(WorkerDict pid=1436351)[0m         if moves.count('_') % 2 == 0:
[36m(WorkerDict pid=1436351)[0m             return left - right
[36m(WorkerDict pid=1436351)[0m         else:
[36m(WorkerDict pid=1436351)[0m             return left + right
