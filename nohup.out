[36m(WorkerDict pid=914214)[0m def solve():
[36m(WorkerDict pid=914214)[0m     n, m, t = map(int, input().split())
[36m(WorkerDict pid=914214)[0m     a = list(map(int, input().split())) 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m     # Find the maximum study time 
[36m(WorkerDict pid=914214)[0m     a.sort() 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m     # Initialize the maximum study time 
[36m(WorkerDict pid=914214)[0m     ans = 0 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m     # Iterate through the couriers 
[36m(WorkerDict pid=914214)[0m     for i in range(n): 
[36m(WorkerDict pid=914214)[0m         # Check if the courier arrives within time 
[36m(WorkerDict pid=914214)[0m         if a[i] >= m and a[i] <= t: 
[36m(WorkerDict pid=914214)[0m             # Update the maximum study time 
[36m(WorkerDict pid=914214)[0m             ans += 1 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m     # Return the maximum study time 
[36m(WorkerDict pid=914214)[0m     print(ans)
[36m(WorkerDict pid=914214)[0m 
