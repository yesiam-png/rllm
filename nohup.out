[36m(WorkerDict pid=1436351)[0m     def sumDigitDifferences(self, nums: List[int]) -> int:
[36m(WorkerDict pid=1436351)[0m         digit_sum = 0
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Iterate through each number in the array
[36m(WorkerDict pid=1436351)[0m         for i in range(len(nums)): 
[36m(WorkerDict pid=1436351)[0m             # Iterate through each digit of the number
[36m(WorkerDict pid=1436351)[0m             num = nums[i]
[36m(WorkerDict pid=1436351)[0m             digit = [] 
[36m(WorkerDict pid=1436351)[0m             
[36m(WorkerDict pid=1436351)[0m             # Iterate through each digit of the number
[36m(WorkerDict pid=1436351)[0m             while num > 0: 
[36m(WorkerDict pid=1436351)[0m                 # Append the digit to the list
[36m(WorkerDict pid=1436351)[0m                 digit.append(num%10) 
[36m(WorkerDict pid=1436351)[0m                 # Remove the last digit from the number
[36m(WorkerDict pid=1436351)[0m                 num = num //10 
[36m(WorkerDict pid=1436351)[0m             
[36m(WorkerDict pid=1436351)[0m             # Iterate through each digit of the number
[36m(WorkerDict pid=1436351)[0m             digit_sum += sum(digit) 
[36m(WorkerDict pid=1436351)[0m             
[36m(WorkerDict pid=1436351)[0m         # Return the total sum of digit differences
[36m(WorkerDict pid=1436351)[0m         return digit_sum
