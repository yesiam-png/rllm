[36m(WorkerDict pid=914465)[0m def solve():
[36m(WorkerDict pid=914465)[0m     n = int(input())
[36m(WorkerDict pid=914465)[0m     data = []
[36m(WorkerDict pid=914465)[0m     for i in range(n):
[36m(WorkerDict pid=914465)[0m         s, t, w = map(int, input().split())
[36m(WorkerDict pid=914465)[0m         data.append((s, t, w))
[36m(WorkerDict pid=914465)[0m 
[36m(WorkerDict pid=914465)[0m     dp = [[0, 0] for _ in range(n)] 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Iterate through each edge 
[36m(WorkerDict pid=914465)[0m     dp[0] = [data[0][2], 0] 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Iterate through each remaining edge 
[36m(WorkerDict pid=914465)[0m     for i in range(1, n): 
[36m(WorkerDict pid=914465)[0m         # Iterate through all previous edges 
[36m(WorkerDict pid=914465)[0m         max1 = dp[i - 1][0]
[36m(WorkerDict pid=914465)[0m         max2 = dp[i - 1][1] 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m         # Iterate through all previous edges 
[36m(WorkerDict pid=914465)[0m         dp[i][0] = max(max1 + data[i][2], max2 + data[i][2]) 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m         # Iterate through all previous edges 
[36m(WorkerDict pid=914465)[0m         dp[i][1] = max(max1, max2) 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Return the maximum diameter 
[36m(WorkerDict pid=914465)[0m 
[36m(WorkerDict pid=914465)[0m     return max([max1 + max2 for max1, max2 in dp])
