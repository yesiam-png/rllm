[36m(WorkerDict pid=914465)[0m def solve():
[36m(WorkerDict pid=914465)[0m     a, l, r = map(int, input().split())
[36m(WorkerDict pid=914465)[0m     mod = 998244353
[36m(WorkerDict pid=914465)[0m     dp = [[0] * 101 for _ in range(101)] 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Initialize the first row and column 
[36m(WorkerDict pid=914465)[0m     for i in range(101):
[36m(WorkerDict pid=914465)[0m         dp[i][i] = 1 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Iterate through the numbers up to 10^1000000 
[36m(WorkerDict pid=914465)[0m     for i in range(1, 101):
[36m(WorkerDict pid=914465)[0m         for j in range(1, 101): 
[36m(WorkerDict pid=914465)[0m             # Iterate through the remaining digits 
[36m(WorkerDict pid=914465)[0m             if i + j <= 100:
[36m(WorkerDict pid=914465)[0m                 dp[i][j] = dp[i][j - 1] + dp[i - 1][j - 1] 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m             # Update the count for the current partition 
[36m(WorkerDict pid=914465)[0m             dp[i][j] %= mod 
