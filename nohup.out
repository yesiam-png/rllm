[36m(WorkerDict pid=914214)[0m     b = list(map(int, input().split())) 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m     # Iterate through each laptop 
[36m(WorkerDict pid=914214)[0m     
[36m(WorkerDict pid=914214)[0m     # Find the minimum price and maximum quality
