[36m(WorkerDict pid=1436351)[0m         # Generate all possible values of x from 0 to 2^n - 1
[36m(WorkerDict pid=1436351)[0m         for x in range(2**n): 
[36m(WorkerDict pid=1436351)[0m             # Calculate the values of (a XOR x) and (b XOR x)
[36m(WorkerDict pid=1436351)[0m             a_xor_x = a ^ (x >> 1)
[36m(WorkerDict pid=1436351)[0m             b_xor_x = b ^ (x >> 1) 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m             # Update the maximum value found
