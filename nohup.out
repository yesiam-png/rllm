[36m(WorkerDict pid=914465)[0m def solve():
[36m(WorkerDict pid=914465)[0m     n = int(input())
[36m(WorkerDict pid=914465)[0m     s = input()
[36m(WorkerDict pid=914465)[0m     a, b = 0, 0
[36m(WorkerDict pid=914465)[0m     ans = []
[36m(WorkerDict pid=914465)[0m     for i in range(1, n + 1):
[36m(WorkerDict pid=914465)[0m         if s[i - 1] == "1":
[36m(WorkerDict pid=914465)[0m             a += 1
[36m(WorkerDict pid=914465)[0m         else:
[36m(WorkerDict pid=914465)[0m             a = 0
[36m(WorkerDict pid=914465)[0m         if s[i - 1] == "?":
[36m(WorkerDict pid=914465)[0m             a = 0
[36m(WorkerDict pid=914465)[0m             b = 0
[36m(WorkerDict pid=914465)[0m         if a > b:
[36m(WorkerDict pid=914465)[0m             b += 1
[36m(WorkerDict pid=914465)[0m         ans.append(max(a, b))
[36m(WorkerDict pid=914465)[0m     return ans
