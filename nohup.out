[36m(WorkerDict pid=914214)[0m     # Iterate through the laptops
[36m(WorkerDict pid=914214)[0m     for i in range(n): 
[36m(WorkerDict pid=914214)[0m         # Check if the conditions are met 
[36m(WorkerDict pid=914214)[0m         # If the price is greater than the minimum price and the quality is less than the maximum quality
