[36m(WorkerDict pid=914465)[0m def solve():
[36m(WorkerDict pid=914465)[0m     # Read input values for a, l, and r
[36m(WorkerDict pid=914465)[0m     a, l, r = map(int, input().split()) 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Initialize the result counter to 0 
[36m(WorkerDict pid=914465)[0m     MOD = 998244353 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Initialize the result counter to 0 
[36m(WorkerDict pid=914465)[0m     dp = [0] * (l + r + 1) 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Set the first element of the partition to 1 
[36m(WorkerDict pid=914465)[0m     dp[l] = 1 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Iterate through each number from l to r 
[36m(WorkerDict pid=914465)[0m     for i in range(l + r, a + 1): 
[36m(WorkerDict pid=914465)[0m         # Iterate through each possible partition 
[36m(WorkerDict pid=914465)[0m         dp[i] = sum(dp[max(0, i - l - 1):i]) % MOD 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Return the final result 
[36m(WorkerDict pid=914465)[0m     return sum(dp[l:r + 1]) % MOD
[36m(WorkerDict pid=914465)[0m 
