[36m(WorkerDict pid=914465)[0m def solve():
[36m(WorkerDict pid=914465)[0m     h, w, n = map(int, input().split())
[36m(WorkerDict pid=914465)[0m     black_cells = [list(map(int, input().split())) for _ in range(n)] 
[36m(WorkerDict pid=914465)[0m     
[36m(WorkerDict pid=914465)[0m     # Initialize the count of ways to reach the goal 
[36m(WorkerDict pid=914465)[0m     grid = [[0] * w for _ in range(h)] 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Initialize the starting cell as white 
[36m(WorkerDict pid=914465)[0m     grid[0][0] = 1 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Iterate through each cell in the grid 
[36m(WorkerDict pid=914465)[0m     for i in range(h):
[36m(WorkerDict pid=914465)[0m         for j in range(w): 
[36m(WorkerDict pid=914465)[0m             # Check if the cell is black 
[36m(WorkerDict pid=914465)[0m             if grid[i][j] == 1: 
[36m(WorkerDict pid=914465)[0m                 # Iterate through neighboring cells 
[36m(WorkerDict pid=914465)[0m                 continue 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m             # Check if the cell is not black 
[36m(WorkerDict pid=914465)[0m             if i > 0: 
[36m(WorkerDict pid=914465)[0m                 # Add the count from the top cell 
[36m(WorkerDict pid=914465)[0m                 grid[i][j] += grid[i - 1][j]
[36m(WorkerDict pid=914465)[0m             if j > 0: 
[36m(WorkerDict pid=914465)[0m                 # Add the count from the left cell 
[36m(WorkerDict pid=914465)[0m                 grid[i][j] += grid[i][j - 1] 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Return the count modulo 10^9 + 7 
[36m(WorkerDict pid=914465)[0m             if (i > 0 and j > 0) and grid[i][j] == 1: 
[36m(WorkerDict pid=914465)[0m                 # Subtract the count from the top-left cell 
[36m(WorkerDict pid=914465)[0m                 grid[i][j] -= grid[i - 1][j - 1] 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Return the count modulo 10^9 + 7 
[36m(WorkerDict pid=914465)[0m             if (i < h - 1 and j < w - 1) and grid[i][j] == 1: 
[36m(WorkerDict pid=914465)[0m                 # Subtract the count from the bottom-right cell 
[36m(WorkerDict pid=914465)[0m                 grid[i][j] -= grid[i + 1][j + 1] 
[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Return the count modulo 10^9 + 7 
[36m(WorkerDict pid=914465)[0m     return grid[h - 1][w - 1] % (10**9 + 7)
