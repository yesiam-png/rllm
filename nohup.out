[36m(WorkerDict pid=914464)[0m def solve():
[36m(WorkerDict pid=914464)[0m     n = int(input()) 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m     # Create a list to store the desks 
[36m(WorkerDict pid=914464)[0m     current_desks = [list(map(int, input().split())) for _ in range(n)] 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m     # Create a list to store the desired desks 
[36m(WorkerDict pid=914464)[0m     total_desks = [0] * (2 * n) 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m     # Iterate through each engineer 
[36m(WorkerDict pid=914464)[0m 
[36m(WorkerDict pid=914464)[0m     for i in range(n): 
[36m(WorkerDict pid=914464)[0m         # Update the current desks list 
[36m(WorkerDict pid=914464)[0m         total_desks[current_desks[i][0] - 1] += 1 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m         # Update the desired desks list 
[36m(WorkerDict pid=914464)[0m         total_desks[current_desks[i][1] - 1] -= 1 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m     # Iterate through the total desks list 
[36m(WorkerDict pid=914464)[0m 
[36m(WorkerDict pid=914464)[0m     current_count = 0
[36m(WorkerDict pid=914464)[0m     total_count = 0
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m     # Iterate through each desk 
[36m(WorkerDict pid=914464)[0m     for i in range(2 * n): 
[36m(WorkerDict pid=914464)[0m         # Update the current count 
[36m(WorkerDict pid=914464)[0m         total_count += total_desks[i] 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m         # Update the current count 
[36m(WorkerDict pid=914464)[0m         if total_desks[i] > 0:
[36m(WorkerDict pid=914464)[0m             current_count += 1 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m     # Return the final count 
[36m(WorkerDict pid=914464)[0m 
[36m(WorkerDict pid=914464)[0m     return current_count * (current_count - 1) // 2 % 1000000007
