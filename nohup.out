[36m(WorkerDict pid=914214)[0m     rectangles = []  
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m     # Iterate through each rectangle 
[36m(WorkerDict pid=914214)[0m     for _ in range(n): 
[36m(WorkerDict pid=914214)[0m         # Get the width and height of the rectangle 
