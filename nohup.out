[36m(WorkerDict pid=1436351)[0m     def furthestDistanceFromOrigin(self, moves: str) -> int:
[36m(WorkerDict pid=1436351)[0m         leftCount = 0
[36m(WorkerDict pid=1436351)[0m         rightCount = 0
[36m(WorkerDict pid=1436351)[0m         for move in moves:
[36m(WorkerDict pid=1436351)[0m             if move == 'L':
[36m(WorkerDict pid=1436351)[0m                 leftCount += 1
[36m(WorkerDict pid=1436351)[0m             elif move == 'R':
[36m(WorkerDict pid=1436351)[0m                 rightCount += 1
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Return the maximum count among left and right
[36m(WorkerDict pid=1436351)[0m         return len(moves) - leftCount - rightCount if leftCount > rightCount else leftCount - rightCount
