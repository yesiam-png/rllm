[36m(WorkerDict pid=218555)[0m afterremove def solve():
[36m(WorkerDict pid=218555)[0m     n = int(input())
[36m(WorkerDict pid=218555)[0m     s = input() 
[36m(WorkerDict pid=218555)[0m   
[36m(WorkerDict pid=218555)[0m     # Check if it is possible to reverse 
[36m(WorkerDict pid=218555)[0m     s = list(s) 
[36m(WorkerDict pid=218555)[0m   
[36m(WorkerDict pid=218555)[0m     # Iterate through each character of the string 
[36m(WorkerDict pid=218555)[0m     i, j = 0, n - 1 
[36m(WorkerDict pid=218555)[0m   
[36m(WorkerDict pid=218555)[0m     # Iterate until the pointers meet 
[36m(WorkerDict pid=218555)[0m     while i < j and s[i] <= s[j]: 
[36m(WorkerDict pid=218555)[0m         # Move the pointers towards the center 
[36m(WorkerDict pid=218555)[0m         i += 1
[36m(WorkerDict pid=218555)[0m     if i == j: 
[36m(WorkerDict pid=218555)[0m         # Return that it is not possible to reverse 
[36m(WorkerDict pid=218555)[0m         print("NO")
[36m(WorkerDict pid=218555)[0m     else: 
[36m(WorkerDict pid=218555)[0m         # Reverse the substring between i and j 
[36m(WorkerDict pid=218555)[0m         s[i], s[j] = s[j], s[i] 
[36m(WorkerDict pid=218555)[0m   
