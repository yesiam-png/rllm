[36m(WorkerDict pid=1436351)[0m class Solution:
[36m(WorkerDict pid=1436351)[0m     def clearDigits(self, s: str) -> str:
[36m(WorkerDict pid=1436351)[0m         # Iterate through the string
[36m(WorkerDict pid=1436351)[0m         i = 0
[36m(WorkerDict pid=1436351)[0m         while i < len(s): 
[36m(WorkerDict pid=1436351)[0m             # Check if the character is a digit
[36m(WorkerDict pid=1436351)[0m             if not s[i].isdigit(): 
[36m(WorkerDict pid=1436351)[0m                 # Move to the next non-digit character
[36m(WorkerDict pid=1436351)[0m                 i += 1
[36m(WorkerDict pid=1436351)[0m             # Otherwise, delete the digit
[36m(WorkerDict pid=1436351)[0m                 continue 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m             # Find the next non-digit character
[36m(WorkerDict pid=1436351)[0m             j = i + 1
[36m(WorkerDict pid=1436351)[0m             while j < len(s): 
[36m(WorkerDict pid=1436351)[0m                 # Check if the character is a digit
[36m(WorkerDict pid=1436351)[0m                 if not s[j].isdigit(): 
[36m(WorkerDict pid=1436351)[0m                     # Move to the next non-digit character
[36m(WorkerDict pid=1436351)[0m                     break 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m                 # Move to the next non-digit character
[36m(WorkerDict pid=1436351)[0m                 j += 1 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m             # Delete the digit from the string
[36m(WorkerDict pid=1436351)[0m             if j - i == 1:
[36m(WorkerDict pid=1436351)[0m                 s = s[:i] + s[j:]
[36m(WorkerDict pid=1436351)[0m                 i = 0
[36m(WorkerDict pid=1436351)[0m             else:
[36m(WorkerDict pid=1436351)[0m                 s = s[:i] + s[j:]
[36m(WorkerDict pid=1436351)[0m                 i = j 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m         # Return the modified string
[36m(WorkerDict pid=1436351)[0m         return s
