[36m(WorkerDict pid=914459)[0m def solve():
[36m(WorkerDict pid=914459)[0m     def bitxor(x,y): 
[36m(WorkerDict pid=914459)[0m         # Initialize result to 0 
[36m(WorkerDict pid=914459)[0m         return x ^ y 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m     # Function to find the smallest triple 
[36m(WorkerDict pid=914459)[0m 
[36m(WorkerDict pid=914459)[0m     def solution(n): 
[36m(WorkerDict pid=914459)[0m         # Initialize the result variable 
[36m(WorkerDict pid=914459)[0m         if n <= 3:
[36m(WorkerDict pid=914459)[0m             return n 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m         # Initialize the result variable 
[36m(WorkerDict pid=914459)[0m         x = 1 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m         # Iterate until the result is found 
[36m(WorkerDict pid=914459)[0m         while n > 3: 
[36m(WorkerDict pid=914459)[0m             # Update the result variable 
[36m(WorkerDict pid=914459)[0m             x = bitxor(x, 1) 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m             # Update the remaining count 
[36m(WorkerDict pid=914459)[0m             n -= 1 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m         # Return the final result 
[36m(WorkerDict pid=914459)[0m         return x 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m 
[36m(WorkerDict pid=914459)[0m     return [solution(int(input())) for _ in range(int(input()))]
