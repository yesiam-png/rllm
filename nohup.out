[36m(WorkerDict pid=914214)[0m     N, C, K = map(int, input().split())
[36m(WorkerDict pid=914214)[0m     T = [int(input()) for _ in range(N)] 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m     # Sort the arrival times in ascending order 
[36m(WorkerDict pid=914214)[0m     T.sort() 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m     # Initialize the count of buses required 
