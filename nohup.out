[36m(WorkerDict pid=914459)[0m 
[36m(WorkerDict pid=914459)[0m def solve():
[36m(WorkerDict pid=914459)[0m     N = int(input()) 
[36m(WorkerDict pid=914459)[0m 
[36m(WorkerDict pid=914459)[0m     # Initialize the minimum number of banknotes 
[36m(WorkerDict pid=914459)[0m     dp = [0] * (N + 1) 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m     # Iterate through each value from 1 to N 
[36m(WorkerDict pid=914459)[0m     dp[0] = 0
[36m(WorkerDict pid=914459)[0m     for i in range(1, N + 1): 
[36m(WorkerDict pid=914459)[0m         # Initialize the minimum number to infinity 
[36m(WorkerDict pid=914459)[0m         min_val = float('inf') 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m         # Iterate through each banknote value 
[36m(WorkerDict pid=914459)[0m         for j in range(1, int(i ** 0.5) + 1): 
[36m(WorkerDict pid=914459)[0m             # Update the minimum value if found 
[36m(WorkerDict pid=914459)[0m             if i >= j:
[36m(WorkerDict pid=914459)[0m                 min_val = min(min_val, dp[i - j] + 1) 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m         # Update the minimum number for the current value 
[36m(WorkerDict pid=914459)[0m         dp[i] = min_val 
