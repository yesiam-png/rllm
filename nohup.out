[36m(WorkerDict pid=914461)[0m def solve():
[36m(WorkerDict pid=914461)[0m     # Get the starting coordinates
[36m(WorkerDict pid=914461)[0m     x_p, y_p, x_v, y_v = map(int, input().split()) 
[36m(WorkerDict pid=914461)[0m   
[36m(WorkerDict pid=914461)[0m     # Check if the pawns are on the same cell 
[36m(WorkerDict pid=914461)[0m 
[36m(WorkerDict pid=914461)[0m     # Calculate the moves
[36m(WorkerDict pid=914461)[0m     move_p = abs(x_p - 0) + abs(y_p - 0)
[36m(WorkerDict pid=914461)[0m     move_v = abs(x_v - 0) + abs(y_v - 0) 
[36m(WorkerDict pid=914461)[0m   
[36m(WorkerDict pid=914461)[0m     # Return the winner based on the moves 
[36m(WorkerDict pid=914461)[0m 
[36m(WorkerDict pid=914461)[0m     # Determine the winner
[36m(WorkerDict pid=914461)[0m     if move_p > move_v:
[36m(WorkerDict pid=914461)[0m         return "Polycarp"
[36m(WorkerDict pid=914461)[0m     elif move_p < move_v:
[36m(WorkerDict pid=914461)[0m         return "Vasiliy"
[36m(WorkerDict pid=914461)[0m     else:
[36m(WorkerDict pid=914461)[0m         return "Draw"
[36m(WorkerDict pid=914461)[0m 
[36m(WorkerDict pid=914461)[0m solve()
