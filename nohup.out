[36m(WorkerDict pid=218553)[0m                 break 
[36m(WorkerDict pid=218553)[0m   
[36m(WorkerDict pid=218553)[0m         # If no recipe matches the query
[36m(WorkerDict pid=218553)[0m         else: 
