[36m(WorkerDict pid=914214)[0m def solve():
[36m(WorkerDict pid=914214)[0m     N, M, T = map(int, input().split())
[36m(WorkerDict pid=914214)[0m     a = list(map(int, input().split()))
[36m(WorkerDict pid=914214)[0m     a.sort()
[36m(WorkerDict pid=914214)[0m     left, right = 0, T
[36m(WorkerDict pid=914214)[0m     while left < right:
[36m(WorkerDict pid=914214)[0m         mid = (left + right) // 2
[36m(WorkerDict pid=914214)[0m         if mid < a[N-1]:
[36m(WorkerDict pid=914214)[0m             break
[36m(WorkerDict pid=914214)[0m         else:
[36m(WorkerDict pid=914214)[0m             left = mid + 1
[36m(WorkerDict pid=914214)[0m     ans = left
[36m(WorkerDict pid=914214)[0m     for i in range(N-1, -1, -1):
[36m(WorkerDict pid=914214)[0m         if a[i] <= T - M:
[36m(WorkerDict pid=914214)[0m             ans = min(ans + M, a[i])
[36m(WorkerDict pid=914214)[0m     print(ans)
[36m(WorkerDict pid=914214)[0m 
