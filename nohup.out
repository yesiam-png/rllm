[36m(WorkerDict pid=218552)[0m afterremove def solve():
[36m(WorkerDict pid=218552)[0m     # Read the number of vertices and edges
[36m(WorkerDict pid=218552)[0m     V, E, r = map(int, input().split()) 
[36m(WorkerDict pid=218552)[0m     
[36m(WorkerDict pid=218552)[0m     # Create a list to store the costs 
[36m(WorkerDict pid=218552)[0m     graph = [[] for _ in range(V)] 
[36m(WorkerDict pid=218552)[0m   
[36m(WorkerDict pid=218552)[0m     # Iterate through the edges 
[36m(WorkerDict pid=218552)[0m     for _ in range(E): 
[36m(WorkerDict pid=218552)[0m         # Read the source and target vertices 
[36m(WorkerDict pid=218552)[0m         s, t, d = map(int, input().split()) 
[36m(WorkerDict pid=218552)[0m   
[36m(WorkerDict pid=218552)[0m         # Add the edge to the graph 
[36m(WorkerDict pid=218552)[0m         graph[s].append((t, d)) 
[36m(WorkerDict pid=218552)[0m   
[36m(WorkerDict pid=218552)[0m     # Initialize the costs array with INF 
[36m(WorkerDict pid=218552)[0m     
[36m(WorkerDict pid=218552)[0m     def dijkstra(graph, start): 
[36m(WorkerDict pid=218552)[0m         # Create a queue to store the vertices 
[36m(WorkerDict pid=218552)[0m         distances = [float('inf')] * V 
[36m(WorkerDict pid=218552)[0m   
[36m(WorkerDict pid=218552)[0m         # Mark the start vertex as visited 
[36m(WorkerDict pid=218552)[0m         distances[start] = 0 
[36m(WorkerDict pid=218552)[0m   
[36m(WorkerDict pid=218552)[0m         # Create a queue to store the vertices 
[36m(WorkerDict pid=218552)[0m         pq = [(0, start)] 
[36m(WorkerDict pid=218552)[0m   
[36m(WorkerDict pid=218552)[0m         # Iterate until the queue is empty 
[36m(WorkerDict pid=218552)[0m         while pq: 
[36m(WorkerDict pid=218552)[0m             # Get the current vertex and its distance 
[36m(WorkerDict pid=218552)[0m             d, node = heapq.heappop(pq) 
[36m(WorkerDict pid=218552)[0m   
[36m(WorkerDict pid=218552)[0m             # Skip if the distance is already visited 
[36m(WorkerDict pid=218552)[0m             if d > distances[node]:
[36m(WorkerDict pid=218552)[0m                 continue 
[36m(WorkerDict pid=218552)[0m   
[36m(WorkerDict pid=218552)[0m             # Iterate through the neighbors of the vertex 
[36m(WorkerDict pid=218552)[0m             for neighbor, cost in graph[node]: 
[36m(WorkerDict pid=218552)[0m                 # Update the distance if a shorter path is found 
[36m(WorkerDict pid=218552)[0m                 if distances[node] + cost < distances[neighbor]:
[36m(WorkerDict pid=218552)[0m                     distances[neighbor] = distances[node] + cost
[36m(WorkerDict pid=218552)[0m                     heapq.heappush(pq, (distances[neighbor], neighbor)) 
[36m(WorkerDict pid=218552)[0m   
[36m(WorkerDict pid=218552)[0m         # Return the distances array 
[36m(WorkerDict pid=218552)[0m         return distances 
[36m(WorkerDict pid=218552)[0m   
[36m(WorkerDict pid=218552)[0m     # Find the shortest path for each vertex 
[36m(WorkerDict pid=218552)[0m     
[36m(WorkerDict pid=218552)[0m     distances = dijkstra(graph, r) 
[36m(WorkerDict pid=218552)[0m   
[36m(WorkerDict pid=218552)[0m     # Print the costs for each vertex 
[36m(WorkerDict pid=218552)[0m     for d in distances: 
[36m(WorkerDict pid=218552)[0m         # Print the cost if it is not infinity 
[36m(WorkerDict pid=218552)[0m         if d == float('inf'):
[36m(WorkerDict pid=218552)[0m             print('INF')
[36m(WorkerDict pid=218552)[0m         else:
[36m(WorkerDict pid=218552)[0m             print(d) 
