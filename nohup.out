[36m(WorkerDict pid=914461)[0m def solve():
[36m(WorkerDict pid=914461)[0m     n = int(input())
[36m(WorkerDict pid=914461)[0m     a = list(map(int, input().split())) 
[36m(WorkerDict pid=914461)[0m   
[36m(WorkerDict pid=914461)[0m     # Initialize the sum of non-deleted elements 
[36m(WorkerDict pid=914461)[0m     even = 0
[36m(WorkerDict pid=914461)[0m     odd = 0 
[36m(WorkerDict pid=914461)[0m   
[36m(WorkerDict pid=914461)[0m     # Iterate through each element of the array 
[36m(WorkerDict pid=914461)[0m     for i in range(n): 
[36m(WorkerDict pid=914461)[0m         # Check the parity of the current element 
[36m(WorkerDict pid=914461)[0m         if i % 2 == 0: 
[36m(WorkerDict pid=914461)[0m             # Add the element to the even sum 
[36m(WorkerDict pid=914461)[0m             even += a[i]
[36m(WorkerDict pid=914461)[0m         else: 
[36m(WorkerDict pid=914461)[0m             # Add the element to the odd sum 
[36m(WorkerDict pid=914461)[0m             odd += a[i] 
[36m(WorkerDict pid=914461)[0m   
[36m(WorkerDict pid=914461)[0m     # Return the minimum sum 
[36m(WorkerDict pid=914461)[0m     if n % 2 == 0: 
[36m(WorkerDict pid=914461)[0m         # Return the minimum sum of the even sum 
[36m(WorkerDict pid=914461)[0m         return min(even, odd)
[36m(WorkerDict pid=914461)[0m     else: 
[36m(WorkerDict pid=914461)[0m         # Return the minimum sum of the odd sum 
[36m(WorkerDict pid=914461)[0m         return 0
