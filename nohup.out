[36m(WorkerDict pid=1436351)[0m     def maxBalancedSubsequenceSum(self, nums: List[int]) -> int:
[36m(WorkerDict pid=1436351)[0m         # Create a dictionary to store the cumulative sums
[36m(WorkerDict pid=1436351)[0m         prefix_sum = [0]
[36m(WorkerDict pid=1436351)[0m         for num in nums:
[36m(WorkerDict pid=1436351)[0m             # Add the current number to the cumulative sum
[36m(WorkerDict pid=1436351)[0m             prefix_sum.append(prefix_sum[-1] + num)
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Create a dictionary to store the maximum sum at each index
[36m(WorkerDict pid=1436351)[0m         max_sum_at_index = defaultdict(int)
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Iterate through the numbers in reverse order
[36m(WorkerDict pid=1436351)[0m         for i in range(len(nums) - 1, -1, -1):
[36m(WorkerDict pid=1436351)[0m             # Iterate through the cumulative sums
[36m(WorkerDict pid=1436351)[0m             # Calculate the maximum sum at each index for the current number
[36m(WorkerDict pid=1436351)[0m             max_sum_at_index[i] = max(prefix_sum[i + 1] - prefix_sum[i] + nums[i], max_sum_at_index[i + 1]) 
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Return the maximum sum found
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Find the maximum sum among all balanced subsequences
[36m(WorkerDict pid=1436351)[0m         max_sum = 0
[36m(WorkerDict pid=1436351)[0m         for i in range(len(nums)):
[36m(WorkerDict pid=1436351)[0m             max_sum = max(max_sum, max_sum_at_index[i])
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         return max_sum
