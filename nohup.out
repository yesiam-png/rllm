[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m     # Iterate through each arrival time 
[36m(WorkerDict pid=914214)[0m     current_time = T[0]
[36m(WorkerDict pid=914214)[0m 
