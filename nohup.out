[36m(WorkerDict pid=914465)[0m   
[36m(WorkerDict pid=914465)[0m     # Initialize the count of ways to reach the goal 
[36m(WorkerDict pid=914465)[0m     # Initialize the dp array
[36m(WorkerDict pid=914465)[0m     dp = [0] * (h + w) 
