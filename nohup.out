[36m(WorkerDict pid=914459)[0m def solve():
[36m(WorkerDict pid=914459)[0m     N, M = map(int, input().split())
[36m(WorkerDict pid=914459)[0m     X, Y, Z = [map(int, input().split()) for _ in range(M)]
[36m(WorkerDict pid=914459)[0m     # dp[i][j] := min cost to determine A_1, A_2, ..., A_i with j pairs of (X, Y) satisfied
[36m(WorkerDict pid=914459)[0m     dp = [[float('inf')] * 101 for _ in range(N + 1)]
[36m(WorkerDict pid=914459)[0m     dp[0][0] = 0
[36m(WorkerDict pid=914459)[0m     for i in range(1, N + 1):
[36m(WorkerDict pid=914459)[0m         for j in range(101): 
[36m(WorkerDict pid=914459)[0m             # Check if the j pairs are satisfied 
[36m(WorkerDict pid=914459)[0m             dp[i][j] = min(dp[i][j], dp[i - 1][j] + 1) 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m             # Check if the j pairs are satisfied 
[36m(WorkerDict pid=914459)[0m             for X, Y, Z in zip(X, Y, Z): 
[36m(WorkerDict pid=914459)[0m                 # Check if the pair is satisfied 
[36m(WorkerDict pid=914459)[0m                 if X > i or Y > i or Z > i:
[36m(WorkerDict pid=914459)[0m                     continue 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m                 # Check if the pair is satisfied 
[36m(WorkerDict pid=914459)[0m                 if X == Y and X == i:
[36m(WorkerDict pid=914459)[0m                     dp[i][j] = min(dp[i][j], dp[i - 1][j - 1] + 1)
[36m(WorkerDict pid=914459)[0m                 elif X != Y and X != i and Y != i:
[36m(WorkerDict pid=914459)[0m                     dp[i][j] = min(dp[i][j], dp[i - 1][j - 1] + 1) 
[36m(WorkerDict pid=914459)[0m   
[36m(WorkerDict pid=914459)[0m     # Return the minimum cost to determine all cards 
[36m(WorkerDict pid=914459)[0m     return dp[N][M]
[36m(WorkerDict pid=914459)[0m 
[36m(WorkerDict pid=914459)[0m solve()
