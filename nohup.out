[36m(WorkerDict pid=218552)[0m     n, k = map(int, input().split())
[36m(WorkerDict pid=218552)[0m     a = list(map(int, input().split())) 
[36m(WorkerDict pid=218552)[0m 
[36m(WorkerDict pid=218552)[0m     # Sort the array in ascending order 
[36m(WorkerDict pid=218552)[0m     
[36m(WorkerDict pid=218552)[0m     a.sort() 
