[36m(WorkerDict pid=218551)[0m afterremove def solve():
[36m(WorkerDict pid=218551)[0m     n = int(input()) 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m     # Create a 2D list to store the numbers 
[36m(WorkerDict pid=218551)[0m     board = [] 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m     # Iterate through each row 
[36m(WorkerDict pid=218551)[0m     for _ in range(n): 
[36m(WorkerDict pid=218551)[0m         # Append a row to the board list 
[36m(WorkerDict pid=218551)[0m         board.append(list(map(int, input().split()))) 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m     # Initialize the count of winning squares 
[36m(WorkerDict pid=218551)[0m     winning_squares = 0 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m     # Iterate through each square 
[36m(WorkerDict pid=218551)[0m     for i in range(n): 
[36m(WorkerDict pid=218551)[0m         # Iterate through each column 
[36m(WorkerDict pid=218551)[0m         sum_col = sum([board[j][i] for j in range(n)])
[36m(WorkerDict pid=218551)[0m         sum_row = sum([board[i][k] for k in range(n)]) 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m         # Check if the square is winning 
[36m(WorkerDict pid=218551)[0m         if sum_col > sum_row:
[36m(WorkerDict pid=218551)[0m             winning_squares += 1 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m     # Return the count of winning squares 
[36m(WorkerDict pid=218551)[0m     return winning_squares 
