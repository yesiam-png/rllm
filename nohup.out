[36m(WorkerDict pid=914214)[0m 
[36m(WorkerDict pid=914214)[0m def solve():
[36m(WorkerDict pid=914214)[0m     N, M, T = map(int, input().split())
[36m(WorkerDict pid=914214)[0m     a = list(map(int, input().split())) 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m     # Find the maximum time Taro can study 
[36m(WorkerDict pid=914214)[0m     dp = [0] * (T + 1) 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m     # Iterate through each courier arrival time 
[36m(WorkerDict pid=914214)[0m     for i in range(N): 
[36m(WorkerDict pid=914214)[0m         # Update the study time for each courier 
[36m(WorkerDict pid=914214)[0m         for j in range(M, a[i] - 1, -M): 
[36m(WorkerDict pid=914214)[0m             # Update the maximum study time 
[36m(WorkerDict pid=914214)[0m             dp[j] = max(dp[j], dp[j - M] + 1) 
[36m(WorkerDict pid=914214)[0m   
[36m(WorkerDict pid=914214)[0m     # Return the maximum study time 
[36m(WorkerDict pid=914214)[0m     print(dp[T])
[36m(WorkerDict pid=914214)[0m 
[36m(WorkerDict pid=914214)[0m solve()
