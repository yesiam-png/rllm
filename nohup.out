[36m(WorkerDict pid=218551)[0m afterremove def solve():
[36m(WorkerDict pid=218551)[0m     # read the input from stdin
[36m(WorkerDict pid=218551)[0m     t = int(input()) 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m     # iterate through each test case 
[36m(WorkerDict pid=218551)[0m     for _ in range(t): 
[36m(WorkerDict pid=218551)[0m         # read the scores and K from stdin 
[36m(WorkerDict pid=218551)[0m         n, k = map(int, input().split()) 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m         # create a list to store the scores 
[36m(WorkerDict pid=218551)[0m         arr = list(map(int, input().split())) 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m         # calculate the maximum possible sum 
[36m(WorkerDict pid=218551)[0m         dp = [[0 for _ in range(k+1)] for _ in range(n+1)] 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m         # iterate through each player and score 
[36m(WorkerDict pid=218551)[0m         for i in range(1, n+1): 
[36m(WorkerDict pid=218551)[0m             # iterate through each possible number of players 
[36m(WorkerDict pid=218551)[0m             for j in range(1, k+1): 
[36m(WorkerDict pid=218551)[0m                 # check if the player is selected 
[36m(WorkerDict pid=218551)[0m                 if j == 1: 
[36m(WorkerDict pid=218551)[0m                     # set the score for the first player 
[36m(WorkerDict pid=218551)[0m                     dp[i][j] = arr[i-1] 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m                 # check if the player is not selected 
[36m(WorkerDict pid=218551)[0m                 elif arr[i-1] + dp[i-1][j-1] > dp[i-1][j]: 
[36m(WorkerDict pid=218551)[0m                     # set the score for the current player 
[36m(WorkerDict pid=218551)[0m                     dp[i][j] = arr[i-1] + dp[i-1][j-1] 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m                 # otherwise, set the score to the previous player 
[36m(WorkerDict pid=218551)[0m                 else:
[36m(WorkerDict pid=218551)[0m                     dp[i][j] = dp[i-1][j] 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m         # return the maximum possible sum 
[36m(WorkerDict pid=218551)[0m         print(dp[n][k]) 
