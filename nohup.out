[36m(WorkerDict pid=218553)[0m 
[36m(WorkerDict pid=218553)[0m 0 <= Q <= 1000
[36m(WorkerDict pid=218553)[0m 
[36m(WorkerDict pid=218553)[0m -10^9 <= Vi <= 10^9
