[36m(WorkerDict pid=1436351)[0m class Solution:
[36m(WorkerDict pid=1436351)[0m     def maxBalancedSubsequenceSum(self, nums: List[int]) -> int:
[36m(WorkerDict pid=1436351)[0m         def maxSum(nums: List[int], i: int, j: int) -> int: 
[36m(WorkerDict pid=1436351)[0m             # If the subsequence is already computed 
[36m(WorkerDict pid=1436351)[0m             if j == 0:
[36m(WorkerDict pid=1436351)[0m                 return nums[i] 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m             # If the subsequence has been computed 
[36m(WorkerDict pid=1436351)[0m             
[36m(WorkerDict pid=1436351)[0m             if (i, j) in memo:
[36m(WorkerDict pid=1436351)[0m                 return memo[(i, j)] 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m             # Initialize the maximum sum for the subsequence 
[36m(WorkerDict pid=1436351)[0m             
[36m(WorkerDict pid=1436351)[0m             if nums[i] - i >= j:
[36m(WorkerDict pid=1436351)[0m                 memo[(i, j)] = maxSum(nums, i+1, j) + nums[i] 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m             # Otherwise, compute the maximum sum recursively 
[36m(WorkerDict pid=1436351)[0m             else:
[36m(WorkerDict pid=1436351)[0m                 memo[(i, j)] = maxSum(nums, i+1, j-1) 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m             # Return the maximum sum for the subsequence 
[36m(WorkerDict pid=1436351)[0m             
[36m(WorkerDict pid=1436351)[0m             return memo[(i, j)] 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m         # Create a dictionary to store computed values 
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         memo = {} 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m         # Return the maximum sum for the entire array 
[36m(WorkerDict pid=1436351)[0m         ans = 0 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m         # Iterate through each element in the array 
[36m(WorkerDict pid=1436351)[0m         for j in range(1, len(nums)): 
[36m(WorkerDict pid=1436351)[0m             # Update the maximum sum for the entire array 
[36m(WorkerDict pid=1436351)[0m             ans = max(ans, maxSum(nums, 0, j)) 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m         # Return the maximum sum for the entire array 
[36m(WorkerDict pid=1436351)[0m             
[36m(WorkerDict pid=1436351)[0m         return ans
