[36m(WorkerDict pid=1436351)[0m class Solution:
[36m(WorkerDict pid=1436351)[0m     def maximumXorProduct(self, a: int, b: int, n: int) -> int:
[36m(WorkerDict pid=1436351)[0m         # Calculate the maximum value of (a XOR x) * (b XOR x)
[36m(WorkerDict pid=1436351)[0m         ans = 0
[36m(WorkerDict pid=1436351)[0m         mod = 10**9 + 7
[36m(WorkerDict pid=1436351)[0m         
[36m(WorkerDict pid=1436351)[0m         # Iterate through all possible values of x
[36m(WorkerDict pid=1436351)[0m         for i in range(1 << n): 
[36m(WorkerDict pid=1436351)[0m             # Check if the current value of x is valid
[36m(WorkerDict pid=1436351)[0m             x = (a ^ i) * (b ^ i) 
[36m(WorkerDict pid=1436351)[0m             
[36m(WorkerDict pid=1436351)[0m             # Update the maximum value of ans
[36m(WorkerDict pid=1436351)[0m             if x > ans:
[36m(WorkerDict pid=1436351)[0m                 ans = x 
[36m(WorkerDict pid=1436351)[0m   
[36m(WorkerDict pid=1436351)[0m         # Return the maximum value of ans
[36m(WorkerDict pid=1436351)[0m         return ans % mod
