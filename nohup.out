[36m(WorkerDict pid=218551)[0m     # Get the length of the row
[36m(WorkerDict pid=218551)[0m     n = int(input()) 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m     # Get the row as a string
[36m(WorkerDict pid=218551)[0m     row = input().strip() 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m     # Initialize the count of integers 
[36m(WorkerDict pid=218551)[0m     count = 0 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m     # Initialize the list to store the integers 
[36m(WorkerDict pid=218551)[0m     result = [] 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m     # Iterate over each character in the row 
[36m(WorkerDict pid=218551)[0m     for i in range(n): 
[36m(WorkerDict pid=218551)[0m         # Check if the current character is black 
[36m(WorkerDict pid=218551)[0m         if row[i] == 'B': 
[36m(WorkerDict pid=218551)[0m             # Increment the count of integers 
[36m(WorkerDict pid=218551)[0m             if count > 0: 
[36m(WorkerDict pid=218551)[0m                 # Append the count to the result list 
[36m(WorkerDict pid=218551)[0m                 result.append(count) 
[36m(WorkerDict pid=218551)[0m             # Start a new count for the next group 
[36m(WorkerDict pid=218551)[0m             count = 0 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m         # Otherwise, increment the count 
[36m(WorkerDict pid=218551)[0m         else:
[36m(WorkerDict pid=218551)[0m             count += 1 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m     # Append the count for the last group 
[36m(WorkerDict pid=218551)[0m     if count > 0:
[36m(WorkerDict pid=218551)[0m         result.append(count) 
[36m(WorkerDict pid=218551)[0m   
[36m(WorkerDict pid=218551)[0m     # Return the list of integers 
