[36m(WorkerDict pid=218553)[0m 
[36m(WorkerDict pid=218553)[0m afterremove def solve():
[36m(WorkerDict pid=218553)[0m     # Your code here
[36m(WorkerDict pid=218553)[0m     s = input() 
[36m(WorkerDict pid=218553)[0m     
[36m(WorkerDict pid=218553)[0m     # Check if the string is a palindrome 
[36m(WorkerDict pid=218553)[0m     freq = [0]*26 
[36m(WorkerDict pid=218553)[0m     
[36m(WorkerDict pid=218553)[0m     # Iterate through each character in the string 
[36m(WorkerDict pid=218553)[0m     for i in s: 
[36m(WorkerDict pid=218553)[0m         # Increment the frequency of the character 
[36m(WorkerDict pid=218553)[0m         freq[ord(i)-ord('a')] += 1 
[36m(WorkerDict pid=218553)[0m   
[36m(WorkerDict pid=218553)[0m     # Initialize count to 0 
[36m(WorkerDict pid=218553)[0m     odd_count = 0 
[36m(WorkerDict pid=218553)[0m   
[36m(WorkerDict pid=218553)[0m     # Iterate through the frequency array 
[36m(WorkerDict pid=218553)[0m     for i in freq: 
[36m(WorkerDict pid=218553)[0m         # Check if the count is odd 
[36m(WorkerDict pid=218553)[0m         if i%2 != 0: 
[36m(WorkerDict pid=218553)[0m             # Increment the count of odd characters 
[36m(WorkerDict pid=218553)[0m             odd_count += 1 
[36m(WorkerDict pid=218553)[0m   
[36m(WorkerDict pid=218553)[0m     # Return true if there is at most one odd count 
