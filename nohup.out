[36m(WorkerDict pid=914464)[0m def solve():
[36m(WorkerDict pid=914464)[0m     n = int(input())
[36m(WorkerDict pid=914464)[0m     colors = [int(c) for c in input().split()]
[36m(WorkerDict pid=914464)[0m     sums = [int(s) for s in input().split()] 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m     # Create an adjacency list to represent the graph 
[36m(WorkerDict pid=914464)[0m     # Create a dictionary to store the sum of edges for each node
[36m(WorkerDict pid=914464)[0m     edge_sums = {i: 0 for i in range(1, n + 1)} 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m     # Iterate through each node and update the edge sums 
[36m(WorkerDict pid=914464)[0m     for i in range(n): 
[36m(WorkerDict pid=914464)[0m         # Update the sum of edges for the current node 
[36m(WorkerDict pid=914464)[0m         edge_sums[colors[i]] += sums[i] 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m     # Create an empty list to store the edges 
[36m(WorkerDict pid=914464)[0m     # Sort the edge_sums dictionary by key in ascending order
[36m(WorkerDict pid=914464)[0m     sorted_edge_sums = sorted(edge_sums.items(), key=lambda x: x[0]) 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m     # Iterate through the sorted edge sums 
[36m(WorkerDict pid=914464)[0m     # Initialize the answer list
[36m(WorkerDict pid=914464)[0m     ans = [] 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m     # Iterate through each sorted edge sum 
[36m(WorkerDict pid=914464)[0m     # Iterate through the sorted edge sums
[36m(WorkerDict pid=914464)[0m     for i in range(1, n): 
[36m(WorkerDict pid=914464)[0m         # Append the edge to the answer list 
[36m(WorkerDict pid=914464)[0m         # Add the edge to the answer list if the sum of edges for the current node is greater than the sum of edges for the next node
[36m(WorkerDict pid=914464)[0m         if sorted_edge_sums[i][1] > sorted_edge_sums[i - 1][1]:
[36m(WorkerDict pid=914464)[0m             ans.append([sorted_edge_sums[i][0], sorted_edge_sums[i - 1][0], sorted_edge_sums[i][1] - sorted_edge_sums[i - 1][1]]) 
[36m(WorkerDict pid=914464)[0m   
[36m(WorkerDict pid=914464)[0m     # Return the list of edges
[36m(WorkerDict pid=914464)[0m     # Print the answer list
[36m(WorkerDict pid=914464)[0m     for edge in ans:
[36m(WorkerDict pid=914464)[0m         print(edge[0], edge[1], edge[2])
