[36m(WorkerDict pid=376191)[0m     dp = [0] * 10001 
[36m(WorkerDict pid=376191)[0m   
[36m(WorkerDict pid=376191)[0m     # Initialize the first term of the sequence 
[36m(WorkerDict pid=376191)[0m     dp[1] = 1
[36m(WorkerDict pid=376191)[0m     for i in range(2, 10001): 
[36m(WorkerDict pid=376191)[0m         # Iterate through all divisors of the current term 
