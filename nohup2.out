[36m(WorkerDict pid=376191)[0m def solve():
[36m(WorkerDict pid=376191)[0m     # Read the input values for each dish
[36m(WorkerDict pid=376191)[0m     A, B, C, D, E = map(int, input().split()) 
[36m(WorkerDict pid=376191)[0m   
[36m(WorkerDict pid=376191)[0m     # Initialize the total time to 0 
[36m(WorkerDict pid=376191)[0m 
[36m(WorkerDict pid=376191)[0m     # Calculate the minimum time required to serve all dishes
[36m(WorkerDict pid=376191)[0m     total_time = 0 
[36m(WorkerDict pid=376191)[0m   
[36m(WorkerDict pid=376191)[0m     # Iterate through each dish 
[36m(WorkerDict pid=376191)[0m     for time in range(A, E + 1, 10): 
[36m(WorkerDict pid=376191)[0m         # Add the serving time to the total time 
[36m(WorkerDict pid=376191)[0m         if time % 10 == 0: 
[36m(WorkerDict pid=376191)[0m             # Add the serving time to the total time 
[36m(WorkerDict pid=376191)[0m             total_time += min(
[36m(WorkerDict pid=376191)[0m                 (time + 10 - A) // (10 - A) * A,
[36m(WorkerDict pid=376191)[0m                 (time + 10 - B) // (10 - B) * B,
[36m(WorkerDict pid=376191)[0m                 (time + 10 - C) // (10 - C) * C,
[36m(WorkerDict pid=376191)[0m                 (time + 10 - D) // (10 - D) * D,
[36m(WorkerDict pid=376191)[0m                 (time + 10 - E) // (10 - E) * E
[36m(WorkerDict pid=376191)[0m             ) 
[36m(WorkerDict pid=376191)[0m   
[36m(WorkerDict pid=376191)[0m     # Return the total time required 
[36m(WorkerDict pid=376191)[0m         else: 
[36m(WorkerDict pid=376191)[0m             # Return the total time required 
[36m(WorkerDict pid=376191)[0m             total_time += 10 
[36m(WorkerDict pid=376191)[0m   
[36m(WorkerDict pid=376191)[0m     # Return the total time required 
[36m(WorkerDict pid=376191)[0m 
[36m(WorkerDict pid=376191)[0m     return total_time
