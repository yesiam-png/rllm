[36m(WorkerDict pid=376191)[0m def solve():
[36m(WorkerDict pid=376191)[0m     N, D, X = map(int, input().split())
[36m(WorkerDict pid=376191)[0m     A = [int(i) for i in input().split()] 
[36m(WorkerDict pid=376191)[0m   
[36m(WorkerDict pid=376191)[0m     # Calculate the total number of pieces eaten 
[36m(WorkerDict pid=376191)[0m     A.sort() 
[36m(WorkerDict pid=376191)[0m   
[36m(WorkerDict pid=376191)[0m     # Calculate the total number of pieces eaten 
[36m(WorkerDict pid=376191)[0m     ans = 0
[36m(WorkerDict pid=376191)[0m     for i in range(N): 
[36m(WorkerDict pid=376191)[0m         # Add the number of pieces eaten by each participant 
[36m(WorkerDict pid=376191)[0m         ans += 2 * (A[i] - 1) 
[36m(WorkerDict pid=376191)[0m   
[36m(WorkerDict pid=376191)[0m     # Return the total number of pieces prepared 
[36m(WorkerDict pid=376191)[0m     ans += X 
[36m(WorkerDict pid=376191)[0m   
[36m(WorkerDict pid=376191)[0m     # Return the final number of pieces prepared 
[36m(WorkerDict pid=376191)[0m     print(ans)
