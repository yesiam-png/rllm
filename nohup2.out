[36m(WorkerDict pid=376191)[0m def solve():
[36m(WorkerDict pid=376191)[0m     n, k = map(int, input().split()) 
[36m(WorkerDict pid=376191)[0m   
[36m(WorkerDict pid=376191)[0m     # Calculate the expected value 
[36m(WorkerDict pid=376191)[0m     MOD = 10**9 + 7 
[36m(WorkerDict pid=376191)[0m   
[36m(WorkerDict pid=376191)[0m     # Initialize the expected value 
[36m(WorkerDict pid=376191)[0m     dp = [0] * (n + 1) 
[36m(WorkerDict pid=376191)[0m   
[36m(WorkerDict pid=376191)[0m     # Initialize the first number on the blackboard 
[36m(WorkerDict pid=376191)[0m     dp[1] = 1 
[36m(WorkerDict pid=376191)[0m   
[36m(WorkerDict pid=376191)[0m     # Iterate through each step 
[36m(WorkerDict pid=376191)[0m     for i in range(2, n + 1): 
[36m(WorkerDict pid=376191)[0m         # Iterate through each divisor 
[36m(WorkerDict pid=376191)[0m         for j in range(1, i + 1): 
[36m(WorkerDict pid=376191)[0m             # Check if the divisor is valid 
[36m(WorkerDict pid=376191)[0m             if i % j == 0: 
[36m(WorkerDict pid=376191)[0m                 # Add the probability to the dp array 
[36m(WorkerDict pid=376191)[0m                 dp[i] += dp[j] 
[36m(WorkerDict pid=376191)[0m   
[36m(WorkerDict pid=376191)[0m     # Calculate the expected value 
[36m(WorkerDict pid=376191)[0m                 dp[i] %= MOD 
[36m(WorkerDict pid=376191)[0m   
[36m(WorkerDict pid=376191)[0m     # Return the expected value 
[36m(WorkerDict pid=376191)[0m     ans = 0
[36m(WorkerDict pid=376191)[0m     for i in range(1, n + 1): 
[36m(WorkerDict pid=376191)[0m         # Add the probability to the answer 
[36m(WorkerDict pid=376191)[0m         if i * k <= n:
[36m(WorkerDict pid=376191)[0m             ans += dp[i] * k 
[36m(WorkerDict pid=376191)[0m   
[36m(WorkerDict pid=376191)[0m     # Return the expected value modulo MOD 
[36m(WorkerDict pid=376191)[0m         else:
[36m(WorkerDict pid=376191)[0m             ans += dp[i] * (n // i) 
[36m(WorkerDict pid=376191)[0m   
[36m(WorkerDict pid=376191)[0m     # Return the expected value modulo MOD 
[36m(WorkerDict pid=376191)[0m         ans %= MOD 
[36m(WorkerDict pid=376191)[0m   
[36m(WorkerDict pid=376191)[0m     # Return the expected value modulo MOD 
[36m(WorkerDict pid=376191)[0m     return ans
