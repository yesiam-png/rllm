[36m(WorkerDict pid=376191)[0m     def super_pad(string, width, fill): 
[36m(WorkerDict pid=376191)[0m         # Check if fill starts with '<' 
[36m(WorkerDict pid=376191)[0m         if not fill or fill[0] != '>': 
[36m(WorkerDict pid=376191)[0m             # Pad the string on the left 
[36m(WorkerDict pid=376191)[0m             left_pad = ' ' * (width - len(string))
[36m(WorkerDict pid=376191)[0m             return left_pad + string 
[36m(WorkerDict pid=376191)[0m   
[36m(WorkerDict pid=376191)[0m         # Check if fill starts with '>' 
[36m(WorkerDict pid=376191)[0m         elif fill[0] != '<': 
[36m(WorkerDict pid=376191)[0m             # Pad the string on the right 
[36m(WorkerDict pid=376191)[0m             right_pad = ' ' * (width - len(string))
[36m(WorkerDict pid=376191)[0m             return string + right_pad 
[36m(WorkerDict pid=376191)[0m   
[36m(WorkerDict pid=376191)[0m         # Check if fill starts with '^' 
[36m(WorkerDict pid=376191)[0m         else: 
[36m(WorkerDict pid=376191)[0m             # Pad the string on both sides 
[36m(WorkerDict pid=376191)[0m             left_pad = ' ' * (width - len(string))
[36m(WorkerDict pid=376191)[0m             right_pad = ' ' * ((width - len(string)) // 2) + string + ' ' * ((width - len(string)) // 2)
[36m(WorkerDict pid=376191)[0m             return left_pad + right_pad 
[36m(WorkerDict pid=376191)[0m   
[36m(WorkerDict pid=376191)[0m     # Return the final padded string 
[36m(WorkerDict pid=376191)[0m 
[36m(WorkerDict pid=376191)[0m     return super_pad
