[36m(WorkerDict pid=376191)[0m     for i in range(1, n):
[36m(WorkerDict pid=376191)[0m         ans += dp[i] * (k - 1)
[36m(WorkerDict pid=376191)[0m         ans %= mod 
[36m(WorkerDict pid=376191)[0m   
[36m(WorkerDict pid=376191)[0m     # Print the expected value 
